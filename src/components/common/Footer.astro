---
import Logo from "./Logo.astro";

const linkClass = "text-muted transition-colors duration-150 ease-smooth hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60";
---

<!-- mt-8 / mt-12 adds top margin above footer border; mt-auto keeps sticky behavior -->
<footer class="mt-8 border-t border-line/70 sm:mt-12">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-8 sm:py-6">
    <!-- Left: Logo -->
    <a
      href="/"
      class="inline-flex items-center rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60"
    >
      <Logo class="text-sm sm:text-base" />
    </a>

    <!-- Right: Privacy Policy & Terms of Service -->
    <nav aria-label="Legal Links">
      <ul class="flex items-center gap-2 text-xs sm:gap-4 sm:text-sm">
        <li>
          <a href="/legal/privacy/" class={linkClass}>
            Privacy
          </a>
        </li>
        <li class="text-line" aria-hidden="true">|</li>
        <li>
          <a href="/legal/terms/" class={linkClass}>
            Terms
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>