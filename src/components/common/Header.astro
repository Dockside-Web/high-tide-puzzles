---
import Logo from "./Logo.astro";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<!-- On puzzle pages (compact) a hairline keeps the site bar apart from the puzzle's own title row -->
<header class:list={["sticky top-0 z-20 bg-canvas/85 backdrop-blur-md", compact && "border-b border-line"]}>
  <div class:list={["mx-auto flex w-full max-w-6xl items-center justify-between px-6 sm:px-8", compact ? "h-14" : "h-20"]}>
    <a
      href="/"
      class="group inline-flex items-center rounded-md cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60"
    >
      <Logo class={compact ? "text-base sm:text-lg" : "text-lg sm:text-2xl"} />
    </a>

    <button
      id="theme-toggle"
      type="button"
      aria-label="Switch to dark mode"
      class="inline-flex h-11 w-11 cursor-pointer items-center justify-center rounded-full text-muted transition-colors duration-150 ease-smooth hover:bg-ink/5 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 dark:hover:bg-ink/10"
    >
      <!-- Dark Mode Icon: Lighthouse OFF (Unlit) -->
      <svg
        id="theme-icon-unlit"
        class="h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9.5 5.5a2.5 2.5 0 0 1 5 0" />
        <path d="M8.5 7h7" />
        <path d="M9 7l-1.5 13h9L15 7" />
        <path d="M6 20h12" />
        <path d="M8.2 11h7.6" />
        <path d="M7.8 15h8.4" />
      </svg>
      
      <!-- Light Mode Icon: Lighthouse ON (Emitting Light Beams) -->
      <svg
        id="theme-icon-lit"
        class="hidden h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9.5 5.5a2.5 2.5 0 0 1 5 0" />
        <path d="M8.5 7h7" />
        <circle cx="12" cy="6" r="0.75" fill="currentColor" />
        <path d="M9 7l-1.5 13h9L15 7" />
        <path d="M6 20h12" />
        <path d="M8.2 11h7.6" />
        <path d="M7.8 15h8.4" />
        <path d="M3.5 4l3.5 1.5" />
        <path d="M20.5 4L17 5.5" />
        <path d="M2.5 7.5l4.5.5" />
        <path d="M21.5 7.5L17 8" />
      </svg>
    </button>
  </div>
</header>

<script>
  const STORAGE_KEY = 'daily-puzzles-theme'
  const toggleBtn = document.getElementById('theme-toggle')
  const unlitIcon = document.getElementById('theme-icon-unlit')
  const litIcon = document.getElementById('theme-icon-lit')

  function syncThemeUI() {
    const isDark = document.documentElement.classList.contains('dark')
    unlitIcon?.classList.toggle('hidden', isDark)
    litIcon?.classList.toggle('hidden', !isDark)
    toggleBtn?.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode')
  }
  syncThemeUI()

  toggleBtn?.addEventListener('click', () => {
    const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark'
    document.documentElement.classList.toggle('dark', next === 'dark')
    document.documentElement.style.colorScheme = next
    localStorage.setItem(STORAGE_KEY, next)
    syncThemeUI()
  })
</script>