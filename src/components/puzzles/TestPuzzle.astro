---
import type { PuzzleConfig } from "../../data/puzzles";

interface Props {
  puzzle: PuzzleConfig;
}

const { puzzle } = Astro.props;

const selectedCell = { row: 0, col: 2 };
const initialGrid = [
  [5, 3, null, null, 7, null, null, null, null],
  [6, null, null, 1, 9, 5, null, null, null],
  [null, 9, 8, null, null, null, null, 6, null],
  [8, null, null, null, 6, null, null, null, 3],
  [4, null, null, 8, null, 3, null, null, 1],
  [7, null, null, null, 2, null, null, null, 6],
  [null, 6, null, null, null, null, 2, 8, null],
  [null, null, null, 4, 1, 9, null, null, 5],
  [null, null, null, null, 8, null, null, 7, 9],
];
---

<div class="flex w-full flex-col items-center gap-4">
  <!-- Difficulty Nav Bar -->
  {
    puzzle.difficulties.length > 1 && (
      <nav class="flex w-full justify-center border-b border-ink/10" aria-label="Difficulty levels">
        <div class="flex gap-2 sm:gap-6">
          {puzzle.difficulties.map((diff, index) => (
            <button
              type="button"
              data-difficulty={diff.id}
              class={`difficulty-tab border-b-2 px-3 py-1.5 text-xs font-semibold transition-colors cursor-pointer ${
                index === 0
                  ? "border-accent text-accent"
                  : "border-transparent text-muted hover:text-ink"
              }`}
            >
              {diff.label}
            </button>
          ))}
        </div>
      </nav>
    )
  }

  <!-- Action Controls -->
  <nav class="flex items-center justify-center gap-1 text-xs font-medium text-muted sm:gap-2">
    <button id="btn-undo" type="button" class="flex items-center gap-1 rounded-md px-2.5 py-1.5 transition-colors hover:bg-ink/5 hover:text-ink cursor-pointer">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg>
      <span>Undo</span>
    </button>
    <button id="btn-redo" type="button" class="flex items-center gap-1 rounded-md px-2.5 py-1.5 transition-colors hover:bg-ink/5 hover:text-ink cursor-pointer">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 7v6h-6"/><path d="M3 17a9 9 0 0 1 9-9 9 9 0 0 1 6 2.3l3 2.7"/></svg>
      <span>Redo</span>
    </button>
    <button id="btn-erase" type="button" class="flex items-center gap-1 rounded-md px-2.5 py-1.5 transition-colors hover:bg-ink/5 hover:text-ink cursor-pointer">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 20H7L3 16c-1.5-1.5-1.5-3.5 0-5l7-7c1.5-1.5 3.5-1.5 5 0l5 5c1.5 1.5 1.5 3.5 0 5l-5 5Z"/><path d="M18 13l-5-5"/></svg>
      <span>Erase</span>
    </button>
    <button id="btn-hint" type="button" class="flex items-center gap-1 rounded-md px-2.5 py-1.5 transition-colors hover:bg-ink/5 hover:text-ink cursor-pointer">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1.3.5 2.6 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/></svg>
      <span>Hint</span>
    </button>
    <button id="btn-restart" type="button" class="flex items-center gap-1 rounded-md px-2.5 py-1.5 transition-colors hover:bg-ink/5 hover:text-ink cursor-pointer">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
      <span>Restart</span>
    </button>
  </nav>

  <!-- Grid Layout -->
  <div class="grid grid-cols-9 overflow-hidden rounded-lg border-2 border-ink bg-surface shadow-md">
    {
      initialGrid.map((row, rowIndex) =>
        row.map((cellValue, colIndex) => {
          const isSelected = selectedCell.row === rowIndex && selectedCell.col === colIndex;
          const isGivenNumber = cellValue !== null;

          const borderRight = colIndex % 3 === 2 && colIndex !== 8 ? "border-r-2 border-r-ink" : "border-r border-r-line";
          const borderBottom = rowIndex % 3 === 2 && rowIndex !== 8 ? "border-b-2 border-b-ink" : "border-b border-b-line";

          return (
            <button
              type="button"
              class={`
                flex h-9 w-9 items-center justify-center text-lg font-bold transition-colors cursor-pointer sm:h-12 sm:w-12 sm:text-xl
                ${borderRight} ${borderBottom}
                ${isSelected ? "bg-accent/20 text-accent outline-2 -outline-offset-2 outline-accent" : "hover:bg-ink/5"}
                ${isGivenNumber ? "font-extrabold text-ink" : "font-semibold text-accent"}
              `}
            >
              {cellValue}
            </button>
          );
        })
      )
    }
  </div>

  <!-- Keypad -->
  <div class="flex gap-2 sm:gap-3">
    {
      [1, 2, 3, 4, 5, 6, 7, 8, 9].map((num) => (
        <button
          type="button"
          class="flex h-9 w-9 items-center justify-center rounded-xl border border-line bg-surface text-base font-bold text-ink shadow-sm transition-transform hover:border-accent hover:text-accent active:scale-95 sm:h-11 sm:w-11 sm:text-lg cursor-pointer"
        >
          {num}
        </button>
      ))
    }
  </div>
</div>

<script>
  const diffTabs = document.querySelectorAll<HTMLButtonElement>('.difficulty-tab');
  diffTabs.forEach((tab) => {
    tab.addEventListener('click', (e) => {
      diffTabs.forEach((t) => t.classList.replace('border-accent', 'border-transparent') && t.classList.replace('text-accent', 'text-muted'));
      const target = e.currentTarget as HTMLButtonElement;
      target.classList.replace('border-transparent', 'border-accent');
      target.classList.replace('text-muted', 'text-accent');

      window.dispatchEvent(new Event('reset-layout-timer'));
    });
  });

  document.getElementById('btn-restart')?.addEventListener('click', () => {
    window.dispatchEvent(new Event('reset-layout-timer'));
  });
</script>