---

interface FaqItem {
  question: string
  answer: string
}

const faqs: FaqItem[] = [
  {
    question: 'What are the daily puzzles?',
    answer:
      'A handful of short logic and word puzzles. Each one takes a few minutes, and everyone gets the same puzzle on the same day.',
  },
  {
    question: 'When are new puzzles released?',
    answer:
      'New puzzles unlock every day at midnight in your local time zone.',
  },
  {
    question: 'Are the puzzles free?',
    answer:
      'Yes. Every puzzle is free to play, with no account or sign-up.',
  },
  {
    question: 'How can I report a problem?',
    answer:
      'Email us using the link below, with the puzzle name and the date.',
  },
]
---

<!-- Reference material well below the puzzles: kept small so it never competes with them -->
<section id="faq" aria-labelledby="faq-heading" class="mx-auto mt-20 w-full max-w-6xl scroll-mt-24 px-6 sm:mt-28 sm:px-8">
  <div class="grid gap-4 border-t border-line pt-10 md:grid-cols-[1fr_2fr] md:gap-12">
    <div>
      <h2 id="faq-heading" class="font-display text-base font-bold tracking-tight text-ink">
        Questions?
      </h2>
      <p class="mt-1 text-sm leading-relaxed text-muted">
        The quick answers. Still stuck?
        <a href="#contact" class="font-semibold text-accent underline-offset-4 hover:underline">Get in touch</a>.
      </p>
    </div>

    <div class="divide-y divide-line border-y border-line" id="faq-list">
      {
        faqs.map((item, index) => {
          const panelId = `faq-panel-${index}`
          const buttonId = `faq-button-${index}`
          return (
            <div data-faq-item>
              <h3>
                <button
                  id={buttonId}
                  type="button"
                  aria-expanded="false"
                  aria-controls={panelId}
                  data-faq-trigger
                  class="flex w-full cursor-pointer items-center justify-between gap-6 py-3 text-left text-sm font-medium text-ink transition-colors duration-150 ease-smooth hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60"
                >
                  {item.question}
                  <span class="shrink-0 text-muted">
                    <svg
                      data-faq-icon
                      aria-hidden="true"
                      class="h-4 w-4 transition-transform duration-200 ease-smooth"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M12 5v14M5 12h14"></path>
                    </svg>
                  </span>
                </button>
              </h3>
              <div
                id={panelId}
                role="region"
                aria-labelledby={buttonId}
                hidden
                data-faq-panel
                class="pb-3 pr-10 text-sm leading-relaxed text-muted"
              >
                {item.answer}
              </div>
            </div>
          )
        })
      }
    </div>
  </div>
</section>

<script>
  function setupFaqAccordion() {
    const triggers = document.querySelectorAll('[data-faq-trigger]')

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('[data-faq-item]')
        if (!item) return

        const panel = item.querySelector('[data-faq-panel]')
        const icon = item.querySelector('[data-faq-icon]')
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true'

        trigger.setAttribute('aria-expanded', String(!isExpanded))

        if (panel) {
          if (isExpanded) {
            panel.setAttribute('hidden', '')
          } else {
            panel.removeAttribute('hidden')
          }
        }

        if (icon) {
          icon.classList.toggle('rotate-45', !isExpanded)
        }
      })
    })
  }

  setupFaqAccordion()
  document.addEventListener('astro:after-swap', setupFaqAccordion)
</script>
