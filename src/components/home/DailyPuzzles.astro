---
import { PUZZLE_LIST } from "../../puzzles";
import { puzzleColorStyle } from "../../puzzles/types";
---

<section
  id="puzzles"
  aria-labelledby="puzzles-heading"
  class="mx-auto w-full max-w-6xl scroll-mt-24 px-6 pt-6 sm:px-8 sm:pt-12"
>
  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
    <h1 id="puzzles-heading" class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      Today's puzzles
    </h1>
    <!-- Filled in by the browser, so it's the player's date rather than the day the site was built -->
    <p class="min-h-5 text-sm font-medium text-muted" data-today-date></p>
  </div>

  <!-- Neutral rows that take on the puzzle's color when hovered -->
  <ul class="mt-6 grid grid-cols-1 gap-3 sm:mt-8 sm:gap-4 lg:grid-cols-2">
    {PUZZLE_LIST.map(({ icon: Icon, ...puzzle }) => (
      <li style={puzzleColorStyle(puzzle.color)}>
        <a
          href={`/${puzzle.slug}/`}
          class="group flex items-center gap-4 rounded-2xl bg-surface px-4 py-4 ring-1 ring-line transition-[background-color,box-shadow] duration-200 ease-smooth hover:bg-puzzle/10 hover:ring-puzzle/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-puzzle sm:px-5"
        >
          <Icon
            class="h-12 w-12 shrink-0 transition-transform duration-200 ease-smooth group-hover:scale-105"
            aria-hidden="true"
          />

          <span class="min-w-0 flex-1">
            <span class="flex items-center gap-2">
              <span class="truncate font-display text-base font-semibold text-ink sm:text-lg">{puzzle.name}</span>
              {puzzle.isNew && (
                <span class="shrink-0 rounded-full bg-coral/15 px-2 py-0.5 text-[11px] font-semibold text-coral-strong">New</span>
              )}
            </span>
            <span class="mt-0.5 block text-sm text-muted">{puzzle.tagline}</span>
          </span>

          <svg class="h-5 w-5 shrink-0 text-muted/60 transition-[color,transform] duration-200 ease-smooth group-hover:translate-x-1 group-hover:text-puzzle-strong" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18l6-6-6-6"></path>
          </svg>
        </a>
      </li>
    ))}
  </ul>
</section>

<script>
  import { onNewDay } from "../../puzzles/daily";

  const dateLabel = document.querySelector<HTMLElement>("[data-today-date]");
  const showDate = () => {
    if (dateLabel) {
      dateLabel.textContent = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" }).format(new Date());
    }
  };

  showDate();
  onNewDay(showDate);
</script>
