---
import type { SvgComponent } from "astro/types";

interface Props {
  name: string;
  icon: SvgComponent;
}

const { name, icon: Icon } = Astro.props;

const iconButtonClass =
  "inline-flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full text-muted transition-colors hover:bg-ink/5 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-puzzle";
---

<!-- data-float: bobs with the solve ripple (SolvedCelebration) -->
<div class="flex items-center gap-3" data-float>
  <a href="/" class={`-ml-2 ${iconButtonClass}`} aria-label="Back to home">
    <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 12H5M12 19l-7-7 7-7"></path>
    </svg>
  </a>

  <Icon class="h-9 w-9 shrink-0 sm:h-10 sm:w-10" aria-hidden="true" />

  <div class="min-w-0 flex-1">
    <h1 class="truncate font-display text-xl leading-tight font-bold tracking-tight text-ink sm:text-2xl">
      {name}
    </h1>
    <!-- Filled in by the browser, so it's the player's date rather than the day the site was built -->
    <p class="min-h-5 truncate text-sm font-medium text-muted" data-today-date></p>
  </div>

  <!-- Labeled, not just an icon, so first-time players can find the rules ("Rules" where space is tight) -->
  <button
    id="help-btn"
    type="button"
    class="inline-flex h-9 shrink-0 cursor-pointer items-center gap-1.5 rounded-full px-3 text-sm font-semibold text-muted ring-1 ring-line transition-colors hover:bg-ink/5 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-puzzle"
  >
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
      <line x1="12" y1="17" x2="12.01" y2="17"></line>
    </svg>
    <span class="sm:hidden">Rules</span>
    <span class="hidden sm:inline">How to play</span>
  </button>
</div>


<script>
  import { onNewDay } from "../../puzzles/daily";

  const dateLabel = document.querySelector<HTMLElement>("[data-today-date]");
  const showDate = () => {
    if (dateLabel) dateLabel.textContent = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric" }).format(new Date());
  };

  showDate();

  // The one place a puzzle page watches for midnight. Puzzles listen for "puzzle:new-day"
  // and load that date's puzzle, and the timer starts over.
  onNewDay((dateKey) => {
    showDate();
    window.dispatchEvent(new Event("puzzle:timer-reset"));
    window.dispatchEvent(new CustomEvent("puzzle:new-day", { detail: { dateKey } }));
  });
</script>
