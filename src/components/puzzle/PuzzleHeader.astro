---
import type { SvgComponent } from "astro/types";

interface Props {
  name: string;
  icon: SvgComponent;
  showSettings: boolean;
}

const { name, icon: Icon, showSettings } = Astro.props;

const todayDate = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
}).format(new Date());

const iconButtonClass =
  "inline-flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full text-muted transition-colors hover:bg-ink/5 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-puzzle";
---

<div class="flex items-center gap-2">
  <a href="/" class={`-ml-2 ${iconButtonClass}`} aria-label="Back to home">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M19 12H5M12 19l-7-7 7-7"></path>
    </svg>
  </a>

  <Icon class="h-6 w-6 shrink-0 sm:h-7 sm:w-7" aria-hidden="true" />

  <div class="flex min-w-0 flex-1 items-baseline gap-2">
    <h1 class="truncate font-display text-xl leading-tight font-bold tracking-tight text-ink sm:text-2xl">
      {name}
    </h1>
    <span class="shrink-0 text-sm font-medium text-muted">{todayDate}</span>
  </div>

  <button id="help-btn" type="button" class={iconButtonClass} aria-label="How to play">
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
      <line x1="12" y1="17" x2="12.01" y2="17"></line>
    </svg>
  </button>

  {showSettings && (
    <button id="settings-btn" type="button" class={`-mr-2 ${iconButtonClass}`} aria-label="Settings">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
    </button>
  )}
</div>

