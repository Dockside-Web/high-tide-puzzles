---
import type { SvgComponent } from "astro/types";
import type { Difficulty } from "../../puzzles/types";

// The same finish for every puzzle. A puzzle only has to fire `puzzle:solved` on window once the
// board is solved; this splashes the board like a pebble dropped in water at the last move, runs a
// wave through the puzzle's pieces and on across the page, then slides up a card with the time. The Timer stops itself on the same event.
// A puzzle that can be lost fires `puzzle:failed` instead (optionally with { message }): the same
// card, without the celebration.
// On a puzzle with more than one difficulty, a win suggests the next one not yet finished today
// ("Try Hard"), and shows which are done.
// Listens for: puzzle:solved (show), puzzle:failed (show, lost), puzzle:timer-reset (a new board was loaded, so hide)

interface Props {
  slug: string;
  name: string;
  icon: SvgComponent;
  difficulties?: Difficulty[];
}

const { slug, name, icon: Icon, difficulties = [] } = Astro.props;
---

<div
  id="solved-celebration"
  class="fixed inset-0 z-40 hidden items-center justify-center bg-canvas/70 px-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="solved-title"
  data-name={name}
  data-slug={slug}
  data-difficulties={JSON.stringify(difficulties)}
>
  <div class="solved-card w-full max-w-sm rounded-3xl bg-surface p-7 text-center shadow-xl ring-1 ring-line sm:p-8">
    <Icon class="solved-icon mx-auto h-14 w-14" aria-hidden="true" />

    <p class="mt-4 text-sm font-semibold text-puzzle-strong" data-solved-cheer></p>
    <h2 id="solved-title" class="mt-1 font-display text-3xl font-bold tracking-tight text-ink">Solved!</h2>
    <p class="mt-2 text-sm text-muted" data-solved-summary></p>

    <!-- Finish time, filled in from the timer (hidden on puzzles without one) -->
    <div class="mt-5 hidden" data-solved-time-row>
      <p class="font-mono text-4xl font-bold tabular-nums text-ink" data-solved-time></p>
      <p class="mt-1 text-xs font-semibold tracking-wide text-muted uppercase">Your time</p>
      <!-- Against past times: "New best! Previous 03:40", or "Best 02:40 · Yesterday 03:12" -->
      <p class="mt-2 hidden text-sm font-semibold text-muted" data-solved-compare></p>
    </div>

    <!-- Days in a row with this puzzle solved -->
    <p class="mt-5 hidden items-center justify-center gap-1.5 text-sm font-semibold text-puzzle-strong" data-solved-streak>
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <path d="M2 9c2.5-2.5 5-2.5 7.5 0s5 2.5 7.5 0 3.5-1.5 5 0M2 16c2.5-2.5 5-2.5 7.5 0s5 2.5 7.5 0 3.5-1.5 5 0"></path>
      </svg>
      <span data-solved-streak-text></span>
    </p>

    <!-- Which of today's difficulties are finished (puzzles with more than one) -->
    <p class="mt-3 hidden text-xs font-semibold text-muted" data-solved-progress></p>

    <div class="mt-7 flex flex-col gap-2 sm:flex-row-reverse">
      <!-- "Try Hard": shown when another difficulty is still to do today -->
      <button
        type="button"
        class="hidden flex-1 cursor-pointer rounded-full bg-puzzle-strong px-5 py-2.5 text-sm font-semibold text-on-color transition-transform hover:scale-[1.03] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-puzzle focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
        data-solved-next
      ></button>
      <a href="/" class="flex-1" data-solved-more>More puzzles</a>
    </div>

    <button
      type="button"
      class="mt-4 cursor-pointer text-sm font-semibold text-muted underline-offset-4 transition-colors hover:text-ink hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-puzzle"
      data-solved-close
    >
      View board
    </button>

    <p class="mt-5 border-t border-line pt-4 text-xs font-medium text-muted" data-solved-next-day></p>
  </div>
</div>

<!-- Dev only (npm run dev, never in the built site): plays the ripple without solving anything -->
{import.meta.env.DEV && (
  <button
    type="button"
    class="fixed right-4 bottom-4 z-50 cursor-pointer rounded-full bg-ink px-4 py-2 text-xs font-semibold text-canvas shadow-lg"
    data-test-ripple
  >
    Test ripple
  </button>
)}

<style>
  #solved-celebration.is-open .solved-card {
    animation: solved-card-in 0.55s cubic-bezier(0.2, 1.3, 0.4, 1) both;
  }

  #solved-celebration.is-open .solved-icon {
    animation: solved-icon-in 0.7s cubic-bezier(0.2, 1.6, 0.4, 1) 0.15s both;
  }

  #solved-celebration.is-open {
    animation: solved-fade-in 0.3s ease both;
  }

  @keyframes solved-fade-in {
    from { opacity: 0; }
  }

  @keyframes solved-card-in {
    from { opacity: 0; transform: translateY(24px) scale(0.92); }
  }

  @keyframes solved-icon-in {
    from { opacity: 0; transform: scale(0.3) rotate(-20deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    #solved-celebration.is-open,
    #solved-celebration.is-open .solved-card,
    #solved-celebration.is-open .solved-icon {
      animation: none;
    }
  }
</style>

<script>
  import { loadProgress, localDateKey } from "../../puzzles/daily";
  import { recordSolve, type SolveResult } from "../../puzzles/stats";

  const CHEERS = [
    "Shipshape!",
    "Smooth sailing!",
    "Making waves!",
    "High tide, high five!",
    "Anchors aweigh!",
    "Ahoy, puzzle pro!",
    "Right on course!",
    "Sea-riously good!",
  ];
  const CARD_DELAY_MS = 1650;

  const overlay = document.getElementById("solved-celebration")!;
  const cheer = overlay.querySelector<HTMLElement>("[data-solved-cheer]")!;
  const title = document.getElementById("solved-title")!;
  const summary = overlay.querySelector<HTMLElement>("[data-solved-summary]")!;
  const timeRow = overlay.querySelector<HTMLElement>("[data-solved-time-row]")!;
  const time = overlay.querySelector<HTMLElement>("[data-solved-time]")!;
  const progress = overlay.querySelector<HTMLElement>("[data-solved-progress]")!;
  const compare = overlay.querySelector<HTMLElement>("[data-solved-compare]")!;
  const streakRow = overlay.querySelector<HTMLElement>("[data-solved-streak]")!;
  const streakText = overlay.querySelector<HTMLElement>("[data-solved-streak-text]")!;
  const nextDay = overlay.querySelector<HTMLElement>("[data-solved-next-day]")!;
  const nextBtn = overlay.querySelector<HTMLButtonElement>("[data-solved-next]")!;
  const more = overlay.querySelector<HTMLElement>("[data-solved-more]")!;
  const closeBtn = overlay.querySelector<HTMLElement>("[data-solved-close]")!;
  const slug = overlay.dataset.slug!;
  const difficulties: { id: string; label: string }[] = JSON.parse(overlay.dataset.difficulties || "[]");
  let nextDifficulty: string | null = null;
  /** The stats from the solve being shown (null for a loss) */
  let result: SolveResult | null = null;
  let nextDayTimer = 0;

  const formatTime = (seconds: number) =>
    `${String(Math.floor(seconds / 60)).padStart(2, "0")}:${String(seconds % 60).padStart(2, "0")}`;
  /** "03:12" off the timer, as seconds (null if there's no timer) */
  const readTimer = () => {
    const [m, sec] = (document.getElementById("timer-display")?.textContent ?? "").split(":").map(Number);
    return Number.isFinite(m) && Number.isFinite(sec) ? m * 60 + sec : null;
  };
  const currentDifficulty = () =>
    document.querySelector<HTMLElement>('[data-event="puzzle:difficulty-change"] [aria-pressed="true"]')?.dataset.value;

  /** "Next puzzle in 6h 12m", counting down to the player's midnight. */
  function showNextDay() {
    const now = new Date();
    const midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
    const minutes = Math.max(1, Math.ceil((midnight.getTime() - now.getTime()) / 60000));
    const h = Math.floor(minutes / 60);
    nextDay.textContent = `Next puzzle in ${h ? `${h}h ` : ""}${minutes % 60}m`;
  }

  /** The line under the time, and the streak. */
  function showStats(seconds: number | null) {
    let line = "";
    if (result && seconds !== null) {
      const best = result.previousBest;
      if (result.newBest) line = `New best! Previous ${formatTime(best!)}`;
      else if (best === null) line = "First solve!";
      else {
        line = `Best ${formatTime(result.repeat ? best : Math.min(best, seconds))}`;
        if (result.yesterday !== null) line += ` · Yesterday ${formatTime(result.yesterday)}`;
      }
    }
    compare.textContent = line;
    compare.classList.toggle("hidden", !line);
    compare.classList.toggle("text-puzzle-strong", !!result?.newBest);

    const streak = result?.streak ?? 0;
    streakText.textContent = `${streak}-day streak`;
    streakRow.classList.toggle("hidden", !streak);
    streakRow.classList.toggle("flex", !!streak);
  }

  // "More puzzles" is the main button unless there's another difficulty to try, then it steps back
  const BUTTON = "rounded-full px-5 py-2.5 text-center text-sm font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-puzzle";
  const MAIN_BUTTON = `${BUTTON} bg-puzzle-strong text-on-color transition-transform hover:scale-[1.03] focus-visible:ring-offset-2 focus-visible:ring-offset-surface`;
  const SECOND_BUTTON = `${BUTTON} text-muted ring-1 ring-line transition-colors hover:bg-ink/5 hover:text-ink`;

  /** Today's finished difficulties: the one just won, plus any saved as solved or revealed. */
  function finishedToday(current: string | undefined) {
    const dateKey = localDateKey();
    return new Set(
      difficulties
        .filter(({ id }) => {
          if (id === current) return true;
          const status = loadProgress<{ status?: string }>(slug, id, dateKey)?.status;
          return status === "solved" || status === "revealed";
        })
        .map(({ id }) => id)
    );
  }

  /** Fills in the difficulty line and the "Try …" button (or hides both on a one-difficulty puzzle). */
  function showDifficulties(won: boolean) {
    const current = document.querySelector<HTMLElement>('[data-event="puzzle:difficulty-change"] [aria-pressed="true"]')?.dataset.value;
    const many = difficulties.length > 1;
    const finished = finishedToday(won ? current : undefined);

    progress.classList.toggle("hidden", !many);
    progress.innerHTML = difficulties
      .map(({ id, label }) =>
        finished.has(id)
          ? `<span class="text-puzzle-strong">${label} <span aria-hidden="true">✓</span><span class="sr-only">(done)</span></span>`
          : `<span>${label}</span>`
      )
      .join(' <span aria-hidden="true">·</span> ');

    // The next difficulty after this one that isn't done, wrapping around (Hard → Easy)
    const first = difficulties.findIndex(({ id }) => id === current);
    const ordered = [...difficulties.slice(first + 1), ...difficulties.slice(0, Math.max(first, 0))];
    const next = won && many ? ordered.find(({ id }) => !finished.has(id)) : undefined;
    nextDifficulty = next?.id ?? null;
    nextBtn.classList.toggle("hidden", !next);
    nextBtn.textContent = next ? `Try ${next.label}` : "";
    more.className = `flex-1 ${next ? SECOND_BUTTON : MAIN_BUTTON}`;
  }
  let cardTimer = 0;

  const reducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function open(failMessage?: string) {
    // Read the finish time and difficulty straight off the page's timer and difficulty tabs
    const finishTime = document.getElementById("timer-display")?.textContent;
    const difficulty = document.querySelector('[data-event="puzzle:difficulty-change"] [aria-pressed="true"]')?.textContent?.trim();
    const puzzleName = `${difficulty ? `${difficulty} ` : ""}${overlay.dataset.name}`;
    const failed = failMessage !== undefined;

    cheer.textContent = failed ? "Rough seas!" : CHEERS[Math.floor(Math.random() * CHEERS.length)];
    title.textContent = failed ? "Not quite" : "Solved!";
    summary.textContent = failed
      ? failMessage || `Better luck with tomorrow's ${puzzleName}.`
      : `You finished today's ${puzzleName}.`;
    timeRow.classList.toggle("hidden", !finishTime || failed);
    time.textContent = finishTime ?? "";
    showStats(failed ? null : readTimer());
    showDifficulties(!failed);
    showNextDay();
    window.clearInterval(nextDayTimer);
    nextDayTimer = window.setInterval(showNextDay, 30000);

    overlay.classList.remove("hidden");
    overlay.classList.add("flex", "is-open");
    // Focus for keyboard players, without drawing the focus ring until they actually use the keyboard
    (nextDifficulty ? nextBtn : more).focus({ focusVisible: false } as FocusOptions);
  }

  function close() {
    window.clearTimeout(cardTimer);
    window.clearInterval(nextDayTimer);
    overlay.classList.add("hidden");
    overlay.classList.remove("flex", "is-open");
  }

  // ---------- Ripple ----------
  // A puzzle marks the bordered part of its board with data-splash (it dips and glows) and its
  // pieces with one of PIECES (the wave lights each one up as it passes). Without data-splash, the
  // whole puzzle is used.
  const PIECES = "[data-cell], [data-tile], [data-island]";
  const IMPACT_MS = 130; // the board's dip before the splash; everything else starts at its lowest point

  /** Where the last tap or click landed, so the ripple can start from the move that solved it */
  let lastPoint: { x: number; y: number } | null = null;
  let lastWasKey = false;
  // Capture phase, so it's noted before the puzzle handles the same event and fires puzzle:solved
  window.addEventListener(
    "pointerup",
    (e) => {
      lastPoint = { x: e.clientX, y: e.clientY };
      lastWasKey = false;
    },
    true
  );
  window.addEventListener("keydown", () => (lastWasKey = true), true);

  /** The last move if it was on the board (a tap there, or the focused piece by keyboard), else the board's middle. */
  function rippleOrigin(splash: HTMLElement) {
    const r = splash.getBoundingClientRect();
    const focused = document.activeElement;
    if (lastWasKey && focused && splash.contains(focused)) {
      const f = focused.getBoundingClientRect();
      return { x: f.left + f.width / 2, y: f.top + f.height / 2 };
    }
    if (!lastWasKey && lastPoint) {
      const { x, y } = lastPoint;
      if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) return lastPoint;
    }
    return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
  }

  /**
   * Like a pebble dropped on the board: the board dips and springs back with a glow, a wave runs
   * out through the puzzle's pieces from the last move, and rings in the puzzle's color roll on across
   * the whole page, fast at first and slowing as they spread. The rings are drawn behind everything,
   * so they pass under the puzzle and show around it.
   */
  function ripple(board: HTMLElement) {
    const width = window.innerWidth;
    const height = window.innerHeight;
    const splash = board.querySelector<HTMLElement>("[data-splash]") ?? (board.firstElementChild as HTMLElement | null) ?? board;
    const { x: originX, y: originY } = rippleOrigin(splash);
    const accent = getComputedStyle(board).getPropertyValue("--puzzle-strong").trim(); // "r g b"

    // Splash-down: dip, overshoot, settle
    splash.animate(
      [
        { scale: 1, easing: "ease-in" },
        { scale: 0.965, offset: 0.2, easing: "ease-out" },
        { scale: 1.025, offset: 0.5, easing: "ease-in-out" },
        { scale: 0.995, offset: 0.75, easing: "ease-in-out" },
        { scale: 1 },
      ],
      { duration: 650 }
    );
    splash.animate(
      [{ boxShadow: `0 0 0 0 rgb(${accent} / 0.55)` }, { boxShadow: `0 0 0 18px rgb(${accent} / 0)` }],
      { duration: 700, delay: IMPACT_MS, easing: "ease-out" }
    );

    const canvas = document.createElement("canvas");
    canvas.setAttribute("aria-hidden", "true");
    // z-index -1: above the page background, below all content
    canvas.style.cssText = "position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:-1";
    document.body.appendChild(canvas);

    const dpr = window.devicePixelRatio || 1;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    const ctx = canvas.getContext("2d")!;
    ctx.scale(dpr, dpr);

    // Each wave is a soft shadow (its trough) just inside a crest in the puzzle's color
    const dark = document.documentElement.classList.contains("dark");
    const shadow = dark ? "0 0 0" : "11 94 117";
    const shadowStrength = dark ? 0.8 : 0.35;
    const crestStrength = dark ? 0.75 : 0.6;

    // Far enough to pass the farthest corner of the screen
    const reach = Math.max(
      ...[[0, 0], [width, 0], [0, height], [width, height]].map(([x, y]) => Math.hypot(x - originX, y - originY))
    ) + 80;

    const WAVES = 4;
    const WAVE_GAP_MS = 220;
    const WAVE_MS = 2400; // time for one wave to cross the screen
    const started = performance.now() + IMPACT_MS;
    // Waves burst out and slow as they spread: the share of `reach` covered by time share t
    const spread = (t: number) => 1 - (1 - t) * (1 - t);
    /** When the first wave reaches a point this far from the origin (ms after the impact) */
    const arrive = (distance: number) => WAVE_MS * (1 - Math.sqrt(1 - Math.min(distance / reach, 1)));
    const distanceTo = (el: Element) => {
      const r = el.getBoundingClientRect();
      return Math.hypot(r.left + r.width / 2 - originX, r.top + r.height / 2 - originY);
    };

    // The wave runs through the puzzle first: each piece lifts and glows as it arrives
    splash.querySelectorAll<HTMLElement | SVGElement>(PIECES).forEach((piece) => {
      if (piece instanceof SVGElement) {
        piece.style.transformBox = "fill-box";
        piece.style.transformOrigin = "center";
      }
      const calm = `drop-shadow(0 0 0 rgb(${accent} / 0)) brightness(1)`;
      piece.animate(
        [
          { scale: 1, filter: calm },
          { scale: 1.14, filter: `drop-shadow(0 0 8px rgb(${accent} / 0.9)) brightness(1.15)`, offset: 0.35 },
          { scale: 1, filter: calm },
        ],
        { duration: 480, delay: IMPACT_MS + arrive(distanceTo(piece)), easing: "ease-out" }
      );
    });

    // The page rides the swell: the header and each block of the puzzle page (marked data-float)
    // lift and settle when the first wave reaches them. Uses `translate`, so it never fights a
    // transform the element already has.
    const BOB_MS = 1400;
    const BOB_PX = 10;
    const bob = Array.from({ length: 29 }, (_, k) => {
      const t = k / 28;
      const y = -BOB_PX * Math.exp(-3.2 * t) * Math.sin(2 * Math.PI * 2.5 * t);
      return { translate: `0 ${y.toFixed(2)}px` };
    });
    document.querySelectorAll<HTMLElement>("header, [data-float]").forEach((el) => {
      el.animate(bob, { duration: BOB_MS, delay: IMPACT_MS + arrive(distanceTo(el)) });
    });

    function frame(now: number) {
      const elapsed = now - started;
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < WAVES; i++) {
        const t = (elapsed - i * WAVE_GAP_MS) / WAVE_MS;
        if (t <= 0 || t >= 1) continue;
        // Waves widen and weaken as they travel, and each one after the first is a little weaker,
        // like a ripple settling
        const radius = spread(t) * reach;
        const half = 14 + 34 * t;
        const strength = Math.pow(1 - t, 1.4) * (1 - i / (WAVES + 1));
        const inner = Math.max(radius - half, 0);

        const gradient = ctx.createRadialGradient(originX, originY, inner, originX, originY, radius + half);
        gradient.addColorStop(0, `rgb(${shadow} / 0)`);
        gradient.addColorStop(0.3, `rgb(${shadow} / ${shadowStrength * strength})`);
        gradient.addColorStop(0.55, `rgb(${shadow} / 0)`);
        gradient.addColorStop(0.72, `rgb(${accent} / ${crestStrength * strength})`);
        gradient.addColorStop(1, `rgb(${accent} / 0)`);

        ctx.beginPath();
        ctx.arc(originX, originY, radius + half, 0, Math.PI * 2);
        ctx.arc(originX, originY, inner, 0, Math.PI * 2, true);
        ctx.fillStyle = gradient;
        ctx.fill();
      }

      if (elapsed < (WAVES - 1) * WAVE_GAP_MS + WAVE_MS) requestAnimationFrame(frame);
      else canvas.remove();
    }
    requestAnimationFrame(frame);
  }

  // ---------- Events ----------
  window.addEventListener("puzzle:solved", () => {
    const board = document.querySelector<HTMLElement>("[data-puzzle-board]");
    result = recordSolve(slug, currentDifficulty() ?? "default", readTimer());

    if (reducedMotion()) {
      open();
      return;
    }

    if (board) ripple(board);
    cardTimer = window.setTimeout(open, board ? CARD_DELAY_MS : 0);
  });

  // Lost: no ripple, and a pause first so the player sees what was marked wrong
  window.addEventListener("puzzle:failed", (e) => {
    const message = (e as CustomEvent<{ message?: string } | null>).detail?.message ?? "";
    result = null;
    window.clearTimeout(cardTimer);
    cardTimer = window.setTimeout(() => open(message), reducedMotion() ? 0 : 1200);
  });

  document.querySelector("[data-test-ripple]")?.addEventListener("click", () => {
    const board = document.querySelector<HTMLElement>("[data-puzzle-board]");
    if (board) ripple(board);
  });

  window.addEventListener("puzzle:timer-reset", close);
  closeBtn.addEventListener("click", close);
  // Switch tabs the same way a player would, so the puzzle and timer follow
  nextBtn.addEventListener("click", () => {
    close();
    document.querySelector<HTMLElement>(`[data-event="puzzle:difficulty-change"] [data-value="${nextDifficulty}"]`)?.click();
  });
  overlay.addEventListener("click", (e) => {
    if (e.target === overlay) close();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && overlay.classList.contains("is-open")) close();
  });
</script>
