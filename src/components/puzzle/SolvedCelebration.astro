---
import type { SvgComponent } from "astro/types";

// The same finish for every puzzle. A puzzle only has to fire `puzzle:solved` on window once the
// board is solved; this pops the board, throws a burst of sea-glass shards, and slides up a card
// with the time. The Timer stops itself on the same event.
// A puzzle that can be lost fires `puzzle:failed` instead (optionally with { message }): the same
// card, without the celebration.
// Listens for: puzzle:solved (show), puzzle:failed (show, lost), puzzle:timer-reset (a new board was loaded, so hide)

interface Props {
  name: string;
  icon: SvgComponent;
}

const { name, icon: Icon } = Astro.props;
---

<div
  id="solved-celebration"
  class="fixed inset-0 z-40 hidden items-center justify-center bg-canvas/70 px-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="solved-title"
  data-name={name}
>
  <div class="solved-card w-full max-w-sm rounded-3xl bg-surface p-7 text-center shadow-xl ring-1 ring-line sm:p-8">
    <Icon class="solved-icon mx-auto h-14 w-14" aria-hidden="true" />

    <p class="mt-4 text-sm font-semibold text-puzzle-strong" data-solved-cheer></p>
    <h2 id="solved-title" class="mt-1 font-display text-3xl font-bold tracking-tight text-ink">Solved!</h2>
    <p class="mt-2 text-sm text-muted" data-solved-summary></p>

    <!-- Finish time, filled in from the timer (hidden on puzzles without one) -->
    <div class="mt-5 hidden" data-solved-time-row>
      <p class="font-mono text-4xl font-bold tabular-nums text-ink" data-solved-time></p>
      <p class="mt-1 text-xs font-semibold tracking-wide text-muted uppercase">Your time</p>
    </div>

    <div class="mt-7 flex flex-col gap-2 sm:flex-row-reverse">
      <a
        href="/"
        class="flex-1 rounded-full bg-puzzle-strong px-5 py-2.5 text-sm font-semibold text-on-color transition-transform hover:scale-[1.03] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-puzzle focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
        data-solved-primary
      >
        More puzzles
      </a>
      <button
        type="button"
        class="flex-1 cursor-pointer rounded-full px-5 py-2.5 text-sm font-semibold text-muted ring-1 ring-line transition-colors hover:bg-ink/5 hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-puzzle"
        data-solved-close
      >
        View board
      </button>
    </div>
  </div>
</div>

<style>
  #solved-celebration.is-open .solved-card {
    animation: solved-card-in 0.55s cubic-bezier(0.2, 1.3, 0.4, 1) both;
  }

  #solved-celebration.is-open .solved-icon {
    animation: solved-icon-in 0.7s cubic-bezier(0.2, 1.6, 0.4, 1) 0.15s both;
  }

  #solved-celebration.is-open {
    animation: solved-fade-in 0.3s ease both;
  }

  /* The board gives a little bounce the moment it's solved */
  :global(.solved-pop) {
    animation: solved-pop 0.5s cubic-bezier(0.2, 1.5, 0.4, 1);
  }

  @keyframes solved-fade-in {
    from { opacity: 0; }
  }

  @keyframes solved-card-in {
    from { opacity: 0; transform: translateY(24px) scale(0.92); }
  }

  @keyframes solved-icon-in {
    from { opacity: 0; transform: scale(0.3) rotate(-20deg); }
  }

  @keyframes solved-pop {
    40% { transform: scale(1.04); }
  }

  @media (prefers-reduced-motion: reduce) {
    #solved-celebration.is-open,
    #solved-celebration.is-open .solved-card,
    #solved-celebration.is-open .solved-icon,
    :global(.solved-pop) {
      animation: none;
    }
  }
</style>

<script>
  const CHEERS = [
    "Shipshape!",
    "Smooth sailing!",
    "Making waves!",
    "High tide, high five!",
    "Anchors aweigh!",
    "Ahoy, puzzle pro!",
    "Right on course!",
    "Sea-riously good!",
  ];
  const SHARD_COLORS = ["ocean", "coral", "sun", "seafoam"];
  const CARD_DELAY_MS = 650;

  const overlay = document.getElementById("solved-celebration")!;
  const cheer = overlay.querySelector<HTMLElement>("[data-solved-cheer]")!;
  const title = document.getElementById("solved-title")!;
  const summary = overlay.querySelector<HTMLElement>("[data-solved-summary]")!;
  const timeRow = overlay.querySelector<HTMLElement>("[data-solved-time-row]")!;
  const time = overlay.querySelector<HTMLElement>("[data-solved-time]")!;
  const primary = overlay.querySelector<HTMLElement>("[data-solved-primary]")!;
  const closeBtn = overlay.querySelector<HTMLElement>("[data-solved-close]")!;
  let cardTimer = 0;

  const reducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function open(failMessage?: string) {
    // Read the finish time and difficulty straight off the page's timer and difficulty tabs
    const finishTime = document.getElementById("timer-display")?.textContent;
    const difficulty = document.querySelector('[data-event="puzzle:difficulty-change"] [aria-pressed="true"]')?.textContent?.trim();
    const puzzleName = `${difficulty ? `${difficulty} ` : ""}${overlay.dataset.name}`;
    const failed = failMessage !== undefined;

    cheer.textContent = failed ? "Rough seas!" : CHEERS[Math.floor(Math.random() * CHEERS.length)];
    title.textContent = failed ? "Not quite" : "Solved!";
    summary.textContent = failed
      ? failMessage || `Better luck with tomorrow's ${puzzleName}.`
      : `You finished today's ${puzzleName}.`;
    timeRow.classList.toggle("hidden", !finishTime || failed);
    time.textContent = finishTime ?? "";

    overlay.classList.remove("hidden");
    overlay.classList.add("flex", "is-open");
    // Focus for keyboard players, without drawing the focus ring until they actually use the keyboard
    primary.focus({ focusVisible: false } as FocusOptions);
  }

  function close() {
    window.clearTimeout(cardTimer);
    overlay.classList.add("hidden");
    overlay.classList.remove("flex", "is-open");
  }

  // ---------- Sea-glass shards ----------
  interface Shard {
    x: number; y: number; vx: number; vy: number;
    angle: number; spin: number; tumble: number; tumbleSpeed: number;
    points: [number, number][]; color: string;
  }

  /** Throws triangle shards in the site's colors up and out from a point, then lets them fall. */
  function burst(originX: number, originY: number) {
    const canvas = document.createElement("canvas");
    canvas.setAttribute("aria-hidden", "true");
    canvas.style.cssText = "position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:50";
    document.body.appendChild(canvas);

    const dpr = window.devicePixelRatio || 1;
    canvas.width = window.innerWidth * dpr;
    canvas.height = window.innerHeight * dpr;
    const ctx = canvas.getContext("2d")!;
    ctx.scale(dpr, dpr);

    const styles = getComputedStyle(document.documentElement);
    const colors = SHARD_COLORS.map((name) => `rgb(${styles.getPropertyValue(`--${name}`).trim()})`);
    const count = window.innerWidth < 640 ? 90 : 150;

    const shards: Shard[] = Array.from({ length: count }, () => {
      const direction = -Math.PI / 2 + (Math.random() - 0.5) * 2.4; // mostly upward
      const speed = 7 + Math.random() * 11;
      const size = 6 + Math.random() * 8;
      return {
        x: originX + (Math.random() - 0.5) * 60,
        y: originY + (Math.random() - 0.5) * 30,
        vx: Math.cos(direction) * speed,
        vy: Math.sin(direction) * speed,
        angle: Math.random() * Math.PI * 2,
        spin: (Math.random() - 0.5) * 0.3,
        tumble: Math.random() * Math.PI * 2,
        tumbleSpeed: 0.05 + Math.random() * 0.1,
        // An uneven triangle, like a broken piece of glass
        points: [0, 1, 2].map((i) => {
          const a = (i / 3) * Math.PI * 2 + (Math.random() - 0.5) * 1.2;
          const r = size * (0.6 + Math.random() * 0.5);
          return [Math.cos(a) * r, Math.sin(a) * r] as [number, number];
        }),
        color: colors[Math.floor(Math.random() * colors.length)],
      };
    });

    const DURATION = 3200;
    const started = performance.now();
    let last = started;

    function frame(now: number) {
      const step = Math.min((now - last) / 16.67, 3); // in 60fps frames, so speed is the same at any refresh rate
      last = now;
      const elapsed = now - started;
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      ctx.globalAlpha = Math.min(1, (DURATION - elapsed) / 700);

      for (const s of shards) {
        s.vy += 0.32 * step;
        s.vx *= Math.pow(0.985, step);
        s.vy *= Math.pow(0.985, step);
        s.x += s.vx * step;
        s.y += s.vy * step;
        s.angle += s.spin * step;
        s.tumble += s.tumbleSpeed * step;

        ctx.save();
        ctx.translate(s.x, s.y);
        ctx.rotate(s.angle);
        ctx.scale(1, Math.cos(s.tumble)); // flipping over as it falls
        ctx.fillStyle = s.color;
        ctx.beginPath();
        ctx.moveTo(...s.points[0]);
        ctx.lineTo(...s.points[1]);
        ctx.lineTo(...s.points[2]);
        ctx.closePath();
        ctx.fill();
        ctx.restore();
      }

      if (elapsed < DURATION) requestAnimationFrame(frame);
      else canvas.remove();
    }
    requestAnimationFrame(frame);
  }

  // ---------- Events ----------
  window.addEventListener("puzzle:solved", () => {
    const board = document.querySelector<HTMLElement>("[data-puzzle-board]");

    if (reducedMotion()) {
      open();
      return;
    }

    if (board) {
      board.classList.remove("solved-pop");
      void board.offsetWidth; // restart the animation if it already ran
      board.classList.add("solved-pop");
      const rect = board.getBoundingClientRect();
      burst(rect.left + rect.width / 2, rect.top + rect.height / 2);
    } else {
      burst(window.innerWidth / 2, window.innerHeight / 2);
    }
    cardTimer = window.setTimeout(open, CARD_DELAY_MS);
  });

  // Lost: no bounce or shards, and a pause first so the player sees what was marked wrong
  window.addEventListener("puzzle:failed", (e) => {
    const message = (e as CustomEvent<{ message?: string } | null>).detail?.message ?? "";
    window.clearTimeout(cardTimer);
    cardTimer = window.setTimeout(() => open(message), reducedMotion() ? 0 : 1200);
  });

  window.addEventListener("puzzle:timer-reset", close);
  closeBtn.addEventListener("click", close);
  overlay.addEventListener("click", (e) => {
    if (e.target === overlay) close();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && overlay.classList.contains("is-open")) close();
  });
</script>
