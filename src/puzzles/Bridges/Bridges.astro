---
import type { PuzzleConfig } from "../types";

interface Props {
  puzzle: PuzzleConfig;
  date?: string;
}

// ---------- Dummy puzzle (frontend only) ----------
// Islands sit on a SIZE x SIZE grid. Each island's number is worked out from the solution
// below, so the dummy puzzle is always solvable.
const SIZE = 9;

const islandCoords: [row: number, col: number][] = [
  [0, 0], [0, 3], [0, 6], [0, 8],
  [2, 0], [2, 2], [2, 5], [2, 8],
  [4, 2], [4, 4], [4, 7],
  [6, 0], [6, 4], [6, 6], [6, 8],
  [8, 0], [8, 3], [8, 6], [8, 8],
];

// Solution as [islandA, islandB, bridges] using indexes into islandCoords
const solution: [number, number, 1 | 2][] = [
  [0, 1, 2], [1, 2, 1], [2, 3, 2], [0, 4, 1], [3, 7, 1],
  [4, 5, 1], [5, 8, 2], [6, 7, 2], [8, 9, 1], [9, 10, 2],
  [9, 12, 1], [7, 14, 1], [4, 11, 2], [11, 12, 1], [12, 13, 2],
  [13, 14, 1], [11, 15, 1], [15, 16, 2], [16, 17, 1], [13, 17, 2],
  [17, 18, 1], [14, 18, 2],
];

const islands = islandCoords.map(([r, c], id) => ({
  id,
  r,
  c,
  target: solution.reduce((sum, [a, b, n]) => sum + (a === id || b === id ? n : 0), 0),
}));

// Every pair of islands that could be bridged: nearest neighbour to the right and below
const pairs: { id: number; a: number; b: number; horizontal: boolean }[] = [];
for (const island of islands) {
  const right = islands
    .filter((o) => o.r === island.r && o.c > island.c)
    .sort((x, y) => x.c - y.c)[0];
  const below = islands
    .filter((o) => o.c === island.c && o.r > island.r)
    .sort((x, y) => x.r - y.r)[0];
  if (right) pairs.push({ id: pairs.length, a: island.id, b: right.id, horizontal: true });
  if (below) pairs.push({ id: pairs.length, a: island.id, b: below.id, horizontal: false });
}

// SVG layout: each grid cell is 100 units
const CELL = 100;
const center = (n: number) => n * CELL + CELL / 2;
const OFFSET = 11; // gap between the two lines of a double bridge
---

<!--
  Interaction:
  - Tap an island to select it, then tap another island in the same row/column to add a bridge.
  - Or tap the gap between two islands. Each tap cycles 0 -> 1 -> 2 -> 0 bridges.
  - Bridges can't cross. Islands grey out when they have the right number, turn red when over.
-->
<div
  class="bridges"
  data-bridges-root
  data-islands={JSON.stringify(islands)}
  data-pairs={JSON.stringify(pairs)}
>
  <svg viewBox={`0 0 ${SIZE * CELL} ${SIZE * CELL}`} class="bridges__svg" role="img" aria-label="Bridges puzzle board">
    <!-- Faint grid points so rows and columns are easy to follow -->
    <g class="bridges__grid">
      {Array.from({ length: SIZE * SIZE }, (_, i) => (
        <circle cx={center(i % SIZE)} cy={center(Math.floor(i / SIZE))} r="4" />
      ))}
    </g>

    <!-- Bridges (and invisible tap targets for each gap) -->
    {pairs.map((pair) => {
      const a = islands[pair.a];
      const b = islands[pair.b];
      const x1 = center(a.c), y1 = center(a.r), x2 = center(b.c), y2 = center(b.r);
      const dx = pair.horizontal ? 0 : OFFSET;
      const dy = pair.horizontal ? OFFSET : 0;
      return (
        <g class="bridges__pair" data-pair={pair.id} data-count="0">
          <line class="bridges__hint" x1={x1} y1={y1} x2={x2} y2={y2} />
          <line class="bridges__line bridges__line--single" x1={x1} y1={y1} x2={x2} y2={y2} />
          <line class="bridges__line bridges__line--double" x1={x1 - dx} y1={y1 - dy} x2={x2 - dx} y2={y2 - dy} />
          <line class="bridges__line bridges__line--double" x1={x1 + dx} y1={y1 + dy} x2={x2 + dx} y2={y2 + dy} />
          <line class="bridges__hit" x1={x1} y1={y1} x2={x2} y2={y2} />
        </g>
      );
    })}

    {islands.map((island) => (
      <g class="bridges__island" data-island={island.id} transform={`translate(${center(island.c)} ${center(island.r)})`}>
        <circle r="36" />
        <text dy="0.36em">{island.target}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .bridges {
    /* Square board that fits the screen width and height so the toolbar stays visible */
    width: min(100%, calc(100dvh - 17.5rem), 34rem);
    min-width: 17rem;
    aspect-ratio: 1;
    box-sizing: border-box;
    padding: 2.5%;
    background: rgb(var(--surface));
    border: 1px solid rgb(var(--line));
    border-radius: 1rem;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .bridges__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .bridges__grid circle {
    fill: rgb(var(--ink) / 0.12);
  }

  .bridges__line {
    stroke: rgb(var(--ink));
    stroke-width: 6;
    stroke-linecap: round;
    display: none;
  }

  .bridges__pair[data-count="1"] .bridges__line--single,
  .bridges__pair[data-count="2"] .bridges__line--double {
    display: inline;
  }

  /* Faint preview of an empty gap on hover */
  .bridges__hint {
    stroke: rgb(var(--puzzle) / 0.35);
    stroke-width: 6;
    stroke-dasharray: 2 14;
    stroke-linecap: round;
    opacity: 0;
    transition: opacity 0.12s ease;
  }

  .bridges__pair[data-count="0"]:hover .bridges__hint {
    opacity: 1;
  }

  .bridges__pair:hover .bridges__line {
    stroke: rgb(var(--puzzle-strong));
  }

  .bridges__hit {
    stroke: transparent;
    stroke-width: 44;
    pointer-events: stroke;
    cursor: pointer;
  }

  .bridges__island {
    cursor: pointer;
  }

  .bridges__island circle {
    fill: rgb(var(--surface));
    stroke: rgb(var(--ink));
    stroke-width: 4;
    transition: fill 0.15s ease, stroke 0.15s ease;
  }

  .bridges__island text {
    fill: rgb(var(--ink));
    font-family: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-size: 40px;
    font-weight: 700;
    text-anchor: middle;
    pointer-events: none;
    transition: fill 0.15s ease;
  }

  .bridges__island:hover circle {
    stroke: rgb(var(--puzzle-strong));
  }

  .bridges__island.is-done circle {
    fill: rgb(var(--band));
    stroke: rgb(var(--ink) / 0.25);
  }

  .bridges__island.is-done text {
    fill: rgb(var(--ink) / 0.35);
  }

  .bridges__island.is-over circle {
    fill: color-mix(in srgb, rgb(var(--coral)) 18%, rgb(var(--surface)));
    stroke: rgb(var(--coral-strong));
  }

  .bridges__island.is-over text {
    fill: rgb(var(--coral-strong));
  }

  .bridges__island.is-selected circle {
    fill: color-mix(in srgb, rgb(var(--puzzle)) 22%, rgb(var(--surface)));
    stroke: rgb(var(--puzzle-strong));
    stroke-width: 6;
  }
</style>

<script>
  interface Island { id: number; r: number; c: number; target: number }
  interface Pair { id: number; a: number; b: number; horizontal: boolean }

  function initBridges(root: HTMLElement) {
    const islands: Island[] = JSON.parse(root.dataset.islands!);
    const pairs: Pair[] = JSON.parse(root.dataset.pairs!);
    const pairEls = Array.from(root.querySelectorAll<SVGGElement>("[data-pair]"));
    const islandEls = Array.from(root.querySelectorAll<SVGGElement>("[data-island]"));

    let counts: number[] = pairs.map(() => 0);
    let history: number[][] = [];
    let selected: number | null = null;

    /** Do two bridges cross? (one horizontal, one vertical, meeting strictly between their islands) */
    function crosses(p: Pair, q: Pair) {
      if (p.horizontal === q.horizontal) return false;
      const [h, v] = p.horizontal ? [p, q] : [q, p];
      const row = islands[h.a].r;
      const col = islands[v.a].c;
      const [c1, c2] = [islands[h.a].c, islands[h.b].c];
      const [r1, r2] = [islands[v.a].r, islands[v.b].r];
      return row > r1 && row < r2 && col > c1 && col < c2;
    }

    function render() {
      pairEls.forEach((el, i) => {
        el.dataset.count = String(counts[i]);
        // Built bridges go on top of empty gaps, so tapping a bridge where an
        // empty gap crosses it always changes the bridge (islands stay above both)
        if (counts[i] > 0) el.parentNode?.insertBefore(el, islandEls[0]);
      });

      islandEls.forEach((el, id) => {
        const total = pairs.reduce((sum, p, i) => sum + (p.a === id || p.b === id ? counts[i] : 0), 0);
        const target = islands[id].target;
        el.classList.toggle("is-done", total === target);
        el.classList.toggle("is-over", total > target);
        el.classList.toggle("is-selected", selected === id);
      });
    }

    /** Cycle a gap 0 -> 1 -> 2 -> 0. Adding is blocked if it would cross an existing bridge. */
    function cycle(pairId: number) {
      const next = (counts[pairId] + 1) % 3;
      if (next > 0 && counts[pairId] === 0) {
        const blocked = pairs.some((q, i) => counts[i] > 0 && crosses(pairs[pairId], q));
        if (blocked) return;
      }
      history.push(counts.slice());
      counts[pairId] = next;
    }

    // Tap the gap between two islands
    pairEls.forEach((el, i) => {
      el.querySelector(".bridges__hit")?.addEventListener("click", () => {
        selected = null;
        cycle(i);
        render();
      });
    });

    // Tap an island, then another island in the same row/column
    islandEls.forEach((el, id) => {
      el.addEventListener("click", () => {
        if (selected === null || selected === id) {
          selected = selected === id ? null : id;
        } else {
          const pairId = pairs.findIndex(
            (p) => (p.a === selected && p.b === id) || (p.b === selected && p.a === id)
          );
          if (pairId === -1) {
            selected = id; // not a neighbour in line: select the new island instead
          } else {
            cycle(pairId);
            selected = null;
          }
        }
        render();
      });
    });

    window.addEventListener("puzzle:undo", () => {
      const previous = history.pop();
      if (!previous) return;
      counts = previous;
      selected = null;
      render();
    });

    window.addEventListener("puzzle:reset", () => {
      if (counts.every((n) => n === 0)) return;
      history.push(counts.slice());
      counts = pairs.map(() => 0);
      selected = null;
      render();
    });

    window.addEventListener("puzzle:difficulty-change", () => {
      counts = pairs.map(() => 0);
      history = [];
      selected = null;
      render();
    });

    render();
  }

  document.querySelectorAll<HTMLElement>("[data-bridges-root]").forEach(initBridges);
</script>
