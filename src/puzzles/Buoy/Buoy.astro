---
import BuoyIcon from "./buoy.svg";
import type { PuzzleConfig } from "../types";
interface Props {
  puzzle: PuzzleConfig;
  date?: string;
}

// Static sample board for frontend development (no daily generation yet)
const regionMap = [
  [9, 9, 3, 3, 3, 6, 6, 6, 6],
  [9, 9, 3, 3, 3, 6, 6, 6, 6],
  [9, 3, 3, 3, 3, 2, 2, 2, 2],
  [9, 9, 4, 3, 3, 3, 2, 2, 2],
  [9, 9, 4, 1, 3, 1, 1, 8, 2],
  [9, 9, 4, 1, 1, 1, 8, 8, 8],
  [9, 4, 4, 4, 1, 1, 8, 8, 8],
  [9, 4, 4, 4, 5, 5, 5, 10, 10],
  [9, 7, 7, 7, 7, 7, 10, 10, 10],
];

// "B" marks a buoy in the solution
const solution = [
  "B...B...B",
  ".........",
  "..B...B.B",
  ".........",
  "..B..B...",
  ".......B.",
  "..B......",
  "......B..",
  "B..B....B",
].map((row) => row.split("").map((ch) => ch === "B"));

const rowTargets = solution.map((row) => row.filter(Boolean).length);
const colTargets = Array.from({ length: 9 }, (_, c) => solution.filter((row) => row[c]).length);

const regionBuoyCounts: Record<number, number> = {};
solution.forEach((row, r) =>
  row.forEach((hasBuoy, c) => {
    if (hasBuoy) regionBuoyCounts[regionMap[r][c]] = (regionBuoyCounts[regionMap[r][c]] || 0) + 1;
  })
);

// Clue count is shown in the first cell (reading order) of each region
const seenRegions = new Set<number>();
const gridData = regionMap.map((row) =>
  row.map((region) => {
    const isFirst = !seenRegions.has(region);
    seenRegions.add(region);
    return { region, count: isFirst ? regionBuoyCounts[region] || 0 : null };
  })
);

function getRegionEdges() {
  const horizontalEdges: { r: number; c: number }[] = [];
  const verticalEdges: { r: number; c: number }[] = [];

  for (let r = 0; r < 9; r++) {
    for (let c = 0; c < 9; c++) {
      const current = gridData[r][c].region;
      if (r === 0 || gridData[r - 1][c].region !== current) horizontalEdges.push({ r, c });
      if (r === 8) horizontalEdges.push({ r: 9, c });
      if (c === 0 || gridData[r][c - 1].region !== current) verticalEdges.push({ r, c });
      if (c === 8) verticalEdges.push({ r, c: 9 });
    }
  }

  return { horizontalEdges, verticalEdges };
}

const { horizontalEdges, verticalEdges } = getRegionEdges();
---

<!-- --cell sizes everything: shrinks to fit the screen width and height so the toolbar stays visible -->
<div
  class="grid max-w-full grid-cols-[calc(var(--cell)*0.6)_auto] gap-1 select-none sm:gap-1.5"
  style="--cell: clamp(1.6rem, min(8.5vw, calc((100dvh - 17.5rem) / 10)), 3.1rem)"
>
  <!-- Top Column Clues (corner spacer first) -->
  <div></div>
  <div class="grid grid-cols-9 px-0.5">
    {colTargets.map((num) => (
      <div class="flex w-(--cell) items-center justify-center text-[calc(var(--cell)*0.36)] font-bold text-ink">
        {num}
      </div>
    ))}
  </div>

  <!-- Left Row Clues -->
  <div class="grid grid-rows-9 py-0.5">
    {rowTargets.map((num) => (
      <div class="flex h-(--cell) items-center justify-center text-[calc(var(--cell)*0.36)] font-bold text-ink">
        {num}
      </div>
    ))}
  </div>

  <div>
    <!-- Region borders are a solid color clearly darker than shaded cells, so shading visibly stops at them -->
    <div style="--region-border: color-mix(in srgb, rgb(var(--ink)) 45%, rgb(var(--surface)))" class="relative overflow-hidden rounded-xl border-2 border-(--region-border) bg-surface shadow-lg">
      <!-- SVG Layer for Connected Region Lines -->
      <svg
        class="pointer-events-none absolute inset-0 z-10 h-full w-full"
        viewBox="0 0 900 900"
        preserveAspectRatio="none"
      >
        {horizontalEdges.map(({ r, c }) => (
          <line
            x1={c * 100}
            y1={r * 100}
            x2={(c + 1) * 100}
            y2={r * 100}
            stroke="var(--region-border)"
            stroke-width="8"
            stroke-linecap="square"
          />
        ))}

        {verticalEdges.map(({ r, c }) => (
          <line
            x1={c * 100}
            y1={r * 100}
            x2={c * 100}
            y2={(r + 1) * 100}
            stroke="var(--region-border)"
            stroke-width="8"
            stroke-linecap="square"
          />
        ))}
      </svg>

      <div class="grid grid-cols-9">
        {
          gridData.map((row, r) =>
            row.map((cell, c) => (
              <button
                type="button"
                data-cell
                data-state="0"
                data-row={r}
                data-col={c}
                class="puzzle-cell relative flex size-(--cell) items-center justify-center transition-colors cursor-pointer bg-surface border border-line/40 touch-none"
              >
                <!-- Corner Region Clue Number -->
                {cell.count !== null && (
                  <span class="absolute top-[8%] left-[8%] z-20 text-[calc(var(--cell)*0.24)] font-bold leading-none text-ink/70 pointer-events-none">
                    {cell.count}
                  </span>
                )}

                <!-- State 0 Dot Indicator -->
                <span data-dot class="size-[calc(var(--cell)*0.12)] rounded-full bg-muted/40 pointer-events-none" />

                <!-- State 2 Buoy Icon -->
                <BuoyIcon
                  data-buoy
                  aria-label="Buoy"
                  class="hidden z-20 size-[calc(var(--cell)*0.62)] pointer-events-none"
                />
              </button>
            ))
          )
        }
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes buoyPop {
    0% {
      transform: scale(0.3);
      opacity: 0;
    }
    70% {
      transform: scale(1.18);
      opacity: 1;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* :global because the buoy is an inline SVG component */
  :global(.buoy-animate) {
    animation: buoyPop 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }
</style>

<script>
  const cells = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-cell]'));

  const UNSELECTED_BG = 'bg-surface';
  const FILLED_BG = 'bg-ocean/20';

  type BoardState = number[];
  let history: BoardState[] = [new Array(81).fill(0)];
  let historyIndex = 0;

  function renderBoard(boardState: BoardState, animateCellIndex: number | null = null) {
    cells.forEach((cell, index) => {
      const state = boardState[index];
      const dot = cell.querySelector<HTMLElement>('[data-dot]');
      const buoy = cell.querySelector<HTMLElement>('[data-buoy]');

      cell.dataset.state = state.toString();

      if (state === 0) {
        cell.classList.remove(FILLED_BG);
        cell.classList.add(UNSELECTED_BG);
        dot?.classList.remove('hidden');
        buoy?.classList.add('hidden');
        buoy?.classList.remove('buoy-animate');
      } else if (state === 1) {
        cell.classList.remove(UNSELECTED_BG);
        cell.classList.add(FILLED_BG);
        dot?.classList.add('hidden');
        buoy?.classList.add('hidden');
        buoy?.classList.remove('buoy-animate');
      } else if (state === 2) {
        cell.classList.remove(UNSELECTED_BG);
        cell.classList.add(FILLED_BG);
        dot?.classList.add('hidden');
        
        if (buoy) {
          buoy.classList.remove('hidden');
          if (animateCellIndex === index) {
            buoy.classList.remove('buoy-animate');
            void buoy.offsetWidth;
            buoy.classList.add('buoy-animate');
          }
        }
      }
    });
  }

  function getCurrentBoardState(): BoardState {
    return cells.map((cell) => parseInt(cell.dataset.state || '0', 10));
  }

  function applyCellChange(cellIndex: number, targetState: number) {
    const currentState = getCurrentBoardState();
    if (currentState[cellIndex] === targetState) return;

    currentState[cellIndex] = targetState;

    history = history.slice(0, historyIndex + 1);
    history.push([...currentState]);
    historyIndex++;

    renderBoard(currentState, targetState === 2 ? cellIndex : null);
  }

  let isMouseDown = false;
  let dragTargetState: number | null = null;

  function handlePointerUp() {
    isMouseDown = false;
    dragTargetState = null;
  }

  window.addEventListener('mouseup', handlePointerUp);
  window.addEventListener('touchend', handlePointerUp);

  cells.forEach((cell, index) => {
    cell.addEventListener('touchstart', (e) => {
      e.preventDefault();
      isMouseDown = true;
      const currentState = parseInt(cell.dataset.state || '0', 10);
      dragTargetState = (currentState + 1) % 3;

      applyCellChange(index, dragTargetState);
    }, { passive: false });

    cell.addEventListener('mousedown', (e) => {
      e.preventDefault();
      isMouseDown = true;

      const currentState = parseInt(cell.dataset.state || '0', 10);
      dragTargetState = (currentState + 1) % 3;

      applyCellChange(index, dragTargetState);
    });

    cell.addEventListener('mouseenter', () => {
      if (isMouseDown && dragTargetState !== null) {
        applyCellChange(index, dragTargetState);
      }
    });
  });

  window.addEventListener('touchmove', (e) => {
    if (!isMouseDown || dragTargetState === null) return;
    const touch = e.touches[0];
    const target = document.elementFromPoint(touch.clientX, touch.clientY);
    const cell = target?.closest('[data-cell]') as HTMLButtonElement | null;
    if (cell) {
      const idx = cells.indexOf(cell);
      if (idx !== -1) applyCellChange(idx, dragTargetState);
    }
  }, { passive: true });

  // --- TOOLBAR EVENT LISTENERS ---

  function handleUndo() {
    if (historyIndex > 0) {
      historyIndex--;
      renderBoard(history[historyIndex]);
    }
  }

  function handleReset() {
    if (historyIndex !== 0 || history.length > 1) {
      history = [new Array(81).fill(0)];
      historyIndex = 0;
      renderBoard(history[0]);
    }
  }

  function handleHint() {
    console.log("Hint requested");
  }

  window.addEventListener('puzzle:undo', handleUndo);
  window.addEventListener('puzzle:reset', handleReset);
  window.addEventListener('puzzle:hint', handleHint);

  window.addEventListener('puzzle:difficulty-change', () => {
    handleReset();
  });
</script>