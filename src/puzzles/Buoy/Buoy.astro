---
import BuoyIcon from "./buoy.svg";
import type { PuzzleConfig } from "../types";
import { SIZE } from "./generate";

interface Props {
  puzzle: PuzzleConfig;
  date?: string;
}

const { puzzle } = Astro.props;
const indexes = Array.from({ length: SIZE }, (_, i) => i);
---

<!--
  The day's regions and clues are made in the browser from the player's local date (see generate.ts).
  Tap a cell to cycle it: water, buoy, empty. Drag to paint the same change across cells.
  Keyboard: arrow keys move between cells, Space or Enter cycles, Delete clears.
  Solved when the buoys are exactly the day's layout (the clues allow only one). On Hard some row and
  column numbers are hidden and left blank.
  --cell sizes everything: shrinks to fit the screen width and height so the toolbar stays visible.
-->
<div
  class="buoy grid max-w-full grid-cols-[calc(var(--cell)*0.6)_auto] gap-1 select-none sm:gap-1.5"
  style="--cell: clamp(1.6rem, min(8.5vw, calc((100dvh - 17.5rem) / 10)), 3.1rem)"
  data-buoy-root
  data-slug={puzzle.slug}
  data-difficulties={(puzzle.difficulties ?? []).map((d) => d.id).join(" ")}
  data-status="loading"
>
  <!-- Column clues (corner spacer first) -->
  <div></div>
  <div class="grid grid-cols-9 px-0.5">
    {indexes.map((c) => (
      <div class="buoy__clue flex w-(--cell) items-center justify-center text-[calc(var(--cell)*0.36)] font-bold" data-col-clue>
        <span class="sr-only">Column {c + 1}:</span><span data-clue-number></span>
      </div>
    ))}
  </div>

  <div class="grid grid-rows-9 py-0.5">
    {indexes.map((r) => (
      <div class="buoy__clue flex h-(--cell) items-center justify-center text-[calc(var(--cell)*0.36)] font-bold" data-row-clue>
        <span class="sr-only">Row {r + 1}:</span><span data-clue-number></span>
      </div>
    ))}
  </div>

  <!-- Region borders are a solid color clearly darker than shaded cells, so shading visibly stops at them.
       The grid lines are see-through, so they show on empty and water cells alike.
       Sized to its cells exactly (not stretched to the clue rows), so no sliver of background shows at an edge -->
  <div
    style="--region-border: color-mix(in srgb, rgb(var(--ink)) 45%, rgb(var(--surface))); --grid-line: rgb(var(--ink) / 0.14)"
    class="relative self-start justify-self-start overflow-hidden rounded-xl border-2 border-(--region-border) bg-surface shadow-lg"
    data-splash
  >
    <!-- Shown over the board while the day's puzzle is being made -->
    <p class="buoy__loading" aria-live="polite"><span>Shuffling today's board…</span></p>

    <svg
      class="pointer-events-none absolute inset-0 z-10 h-full w-full"
      viewBox={`0 0 ${SIZE * 100} ${SIZE * 100}`}
      preserveAspectRatio="none"
      aria-hidden="true"
      data-borders
    ></svg>

    <div class="grid grid-cols-[repeat(9,var(--cell))]" role="group" aria-label="Buoy board">
      {indexes.map((r) =>
        indexes.map((c) => (
          <button
            type="button"
            data-cell
            tabindex={r === 0 && c === 0 ? 0 : -1}
            class="buoy__cell relative flex size-(--cell) cursor-pointer touch-none items-center justify-center bg-surface transition-colors"
          >
            <span
              class="buoy__region-clue pointer-events-none absolute top-[8%] left-[8%] z-20 text-[calc(var(--cell)*0.24)] leading-none font-bold"
              aria-hidden="true"
              data-region-clue
              hidden
            ></span>
            <span data-dot class="pointer-events-none size-[calc(var(--cell)*0.12)] rounded-full bg-muted/40" aria-hidden="true"></span>
            <BuoyIcon data-buoy class="pointer-events-none z-20 hidden size-[calc(var(--cell)*0.62)]" aria-hidden="true" />
          </button>
        ))
      )}
    </div>
  </div>
</div>

<style>
  .buoy__clue,
  .buoy__region-clue {
    color: rgb(var(--ink));
    transition: color 0.15s ease, opacity 0.15s ease;
  }

  .buoy__region-clue {
    color: rgb(var(--ink) / 0.7);
  }

  /* A row, column or region with exactly its number of buoys fades back; one with too many turns coral */
  .buoy__clue.is-done,
  .buoy__region-clue.is-done {
    opacity: 0.35;
  }

  .buoy__clue.is-over,
  .buoy__region-clue.is-over {
    color: rgb(var(--coral-strong));
  }

  /* Solid (the same shade as ocean at 20% over the board) with a hair of it spilling past the
     edges: at some screen scalings neighboring cells round apart and leave a sliver of gap, which
     would show the board behind as a thin line. (The grid lines are drawn over the cells, so this
     never covers them) */
  .buoy__cell[data-state="1"],
  .buoy__cell[data-state="2"] {
    --water: color-mix(in srgb, rgb(var(--ocean)) 20%, rgb(var(--surface)));
    background: var(--water);
    box-shadow: 0 0 0 0.5px var(--water);
  }

  .buoy__cell:focus-visible {
    z-index: 30;
    outline: 3px solid rgb(var(--puzzle-strong));
    outline-offset: -3px;
  }

  .buoy__loading {
    position: absolute;
    inset: 0;
    z-index: 30;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgb(var(--surface));
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(var(--muted));
  }

  /* Only the words pulse; the cover stays solid so the last board never shows through */
  .buoy__loading span {
    animation: buoy-pulse 1.2s ease-in-out infinite;
  }

  .buoy[data-status="loading"] .buoy__loading {
    display: flex;
  }

  /* No clues from the last board while the next one is made */
  .buoy[data-status="loading"] .buoy__clue {
    visibility: hidden;
  }

  @keyframes buoy-pulse {
    50% { opacity: 0.45; }
  }

  .buoy.is-locked .buoy__cell {
    cursor: default;
  }

  /* A cell changed by Hint pulses in the puzzle's color */
  .buoy__cell.is-hinted {
    animation: buoy-hint 0.4s ease-in-out 2;
  }

  @keyframes buoy-hint {
    50% { background: rgb(var(--puzzle) / 0.45); }
  }

  @keyframes buoyPop {
    0% {
      transform: scale(0.3);
      opacity: 0;
    }
    70% {
      transform: scale(1.18);
      opacity: 1;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* :global because the buoy is an inline SVG component */
  :global(.buoy-animate) {
    animation: buoyPop 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .buoy__loading span,
    .buoy__cell.is-hinted,
    :global(.buoy-animate) {
      animation: none;
    }
  }
</style>

<script>
  import { dailyPuzzles, forgetOldProgress, loadProgress, localDateKey, onFinishedElsewhere, saveProgress, startingDifficulty } from "../daily";
  import { SIZE, generateBuoy, type BuoyDifficulty, type BuoyPuzzle } from "./generate";

  const EMPTY = 0;
  const WATER = 1;
  const BUOY = 2;
  const STATE_NAMES = ["empty", "water", "buoy"];

  type Status = "loading" | "playing" | "solved" | "revealed";

  /** What's saved for one day at one difficulty */
  interface SavedGame {
    cells: number[];
    seconds: number;
    status: "playing" | "solved" | "revealed";
  }

  const root = document.querySelector<HTMLElement>("[data-buoy-root]")!;
  const slug = root.dataset.slug!;
  const cellEls = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-cell]"));
  const rowClues = Array.from(root.querySelectorAll<HTMLElement>("[data-row-clue]"));
  const colClues = Array.from(root.querySelectorAll<HTMLElement>("[data-col-clue]"));
  const bordersSvg = root.querySelector<SVGSVGElement>("[data-borders]")!;
  const difficulties = root.dataset.difficulties!.split(" ") as BuoyDifficulty[];
  const puzzles = dailyPuzzles(slug, difficulties, generateBuoy);

  let dateKey = localDateKey();
  let difficulty = startingDifficulty(slug, difficulties); // the first not finished today (PuzzleControls picks the same tab)
  let puzzle: BuoyPuzzle;
  /** Region number -> the cell showing its clue (the region's first cell in reading order) */
  let regionClueCell = new Map<number, number>();
  let board: number[] = new Array(SIZE * SIZE).fill(EMPTY);
  let undoStack: number[][] = [];
  let status: Status = "playing";
  let seconds = 0;
  let focusIndex = 0;

  const rowOf = (cell: number) => Math.floor(cell / SIZE);
  const colOf = (cell: number) => cell % SIZE;
  const plural = (n: number) => `${n} buoy${n === 1 ? "" : "s"}`;

  function save() {
    if (status === "loading") return;
    saveProgress(slug, difficulty, dateKey, { cells: board, seconds, status } satisfies SavedGame);
  }

  function setStatus(next: Status) {
    status = next;
    root.dataset.status = next;
    root.classList.toggle("is-locked", next !== "playing");
  }

  /** Resolves once the browser has drawn the current state (so "Shuffling…" shows before the heavy work). */
  const nextPaint = () => new Promise<void>((resolve) => requestAnimationFrame(() => setTimeout(resolve, 0)));
  let loadId = 0;

  // ---------- Drawing ----------
  // The thin grid, one line between each pair of cells (cells have no borders of their own, which
  // would double up into two lines with a sliver between). Kept 1px whatever the board's size.
  const gridPath = Array.from({ length: SIZE - 1 }, (_, i) => `M${(i + 1) * 100} 0V${SIZE * 100}M0 ${(i + 1) * 100}H${SIZE * 100}`).join("");
  const gridLines = `<path d="${gridPath}" stroke="var(--grid-line)" stroke-width="1" vector-effect="non-scaling-stroke" />`;

  /** Grid lines, region borders and the clue numbers that don't change while playing. */
  function drawPuzzle() {
    const lines: string[] = [gridLines];
    const line = (x1: number, y1: number, x2: number, y2: number) =>
      lines.push(`<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="var(--region-border)" stroke-width="8" stroke-linecap="square" />`);
    puzzle.regions.forEach((g, cell) => {
      const r = rowOf(cell);
      const c = colOf(cell);
      if (r > 0 && puzzle.regions[cell - SIZE] !== g) line(c * 100, r * 100, (c + 1) * 100, r * 100);
      if (c > 0 && puzzle.regions[cell - 1] !== g) line(c * 100, r * 100, c * 100, (r + 1) * 100);
    });
    bordersSvg.innerHTML = lines.join("");

    regionClueCell = new Map();
    puzzle.regions.forEach((g, cell) => regionClueCell.has(g) || regionClueCell.set(g, cell));
    cellEls.forEach((el, cell) => {
      const clue = el.querySelector<HTMLElement>("[data-region-clue]")!;
      const g = puzzle.regions[cell];
      clue.hidden = regionClueCell.get(g) !== cell;
      clue.textContent = String(puzzle.regionCounts[g]);
    });
    const showClue = (el: HTMLElement, count: number | null) => {
      el.querySelector("[data-clue-number]")!.innerHTML = count === null ? '<span class="sr-only">hidden</span>' : String(count);
    };
    rowClues.forEach((el, r) => showClue(el, puzzle.rowCounts[r]));
    colClues.forEach((el, c) => showClue(el, puzzle.colCounts[c]));
  }

  /** Cells, their labels, and how each clue is doing. `pop` animates a newly placed buoy. */
  function render(pop: number | null = null) {
    const rows = new Array(SIZE).fill(0);
    const cols = new Array(SIZE).fill(0);
    const regions = new Array(puzzle.regionCounts.length).fill(0);
    board.forEach((state, cell) => {
      if (state !== BUOY) return;
      rows[rowOf(cell)]++;
      cols[colOf(cell)]++;
      regions[puzzle.regions[cell]]++;
    });

    // A hidden number (null) is never marked done or over
    const mark = (el: Element, have: number, want: number | null) => {
      el.classList.toggle("is-done", have === want);
      el.classList.toggle("is-over", want !== null && have > want);
    };
    rowClues.forEach((el, r) => mark(el, rows[r], puzzle.rowCounts[r]));
    colClues.forEach((el, c) => mark(el, cols[c], puzzle.colCounts[c]));

    cellEls.forEach((el, cell) => {
      const state = board[cell];
      const g = puzzle.regions[cell];
      el.dataset.state = String(state);
      el.querySelector("[data-dot]")!.classList.toggle("hidden", state !== EMPTY);
      const buoy = el.querySelector("[data-buoy]")!;
      buoy.classList.toggle("hidden", state !== BUOY);
      buoy.classList.remove("buoy-animate");
      if (cell === pop) {
        void (buoy as HTMLElement).getBoundingClientRect(); // restart the pop if it already ran
        buoy.classList.add("buoy-animate");
      }

      let label = `Row ${rowOf(cell) + 1}, column ${colOf(cell) + 1}: ${STATE_NAMES[state]}`;
      if (regionClueCell.get(g) === cell) {
        mark(el.querySelector("[data-region-clue]")!, regions[g], puzzle.regionCounts[g]);
        label += `. Its region holds ${plural(puzzle.regionCounts[g])}`;
      }
      el.setAttribute("aria-label", label);
    });
  }

  // ---------- Changing cells ----------
  /** After any change: redraw, catch the moment it's solved, and save. */
  function changed(pop: number | null = null) {
    const solved = board.every((state, cell) => (state === BUOY) === puzzle.solution[cell]);
    if (solved && status === "playing") {
      setStatus("solved");
      fillWater();
      render(pop);
      window.dispatchEvent(new Event("puzzle:solved"));
    } else {
      render(pop);
    }
    save();
  }

  /** Once solved, every cell left empty becomes water so the finished board has no loose ends. */
  function fillWater() {
    board = board.map((state) => (state === EMPTY ? WATER : state));
  }

  /** One undoable change to a single cell (keyboard and Hint). */
  function setCell(cell: number, state: number) {
    if (status !== "playing" || board[cell] === state) return;
    undoStack.push([...board]);
    board[cell] = state;
    changed(state === BUOY ? cell : null);
  }

  // Tap or drag: the first cell decides the change (its next state), and every cell the pointer
  // crosses gets the same one. The whole stroke is one step for Undo.
  let stroke: { state: number; before: number[] } | null = null;

  function paint(cell: number) {
    if (!stroke || board[cell] === stroke.state) return;
    board[cell] = stroke.state;
    render(stroke.state === BUOY ? cell : null);
  }

  function endStroke() {
    if (!stroke) return;
    if (stroke.before.some((state, cell) => state !== board[cell])) {
      undoStack.push(stroke.before);
      changed();
    }
    stroke = null;
  }

  cellEls.forEach((el, cell) => {
    el.addEventListener("pointerdown", (e) => {
      if (status !== "playing" || e.button !== 0) return;
      e.preventDefault(); // no text selection or focus jump while dragging
      setFocus(cell, false);
      stroke = { state: (board[cell] + 1) % 3, before: [...board] };
      paint(cell);
    });
  });

  window.addEventListener("pointermove", (e) => {
    if (!stroke) return;
    const el = document.elementFromPoint(e.clientX, e.clientY)?.closest<HTMLButtonElement>("[data-cell]");
    const cell = el ? cellEls.indexOf(el) : -1;
    if (cell !== -1) paint(cell);
  });
  window.addEventListener("pointerup", endStroke);
  window.addEventListener("pointercancel", endStroke);

  // ---------- Keyboard ----------
  /** Only one cell is in the tab order at a time; the arrow keys move it. */
  function setFocus(cell: number, moveFocus: boolean) {
    cellEls[focusIndex].tabIndex = -1;
    focusIndex = cell;
    cellEls[cell].tabIndex = 0;
    if (moveFocus) cellEls[cell].focus();
  }

  root.addEventListener("keydown", (e) => {
    const el = (e.target as Element).closest<HTMLButtonElement>("[data-cell]");
    if (!el) return;
    const cell = cellEls.indexOf(el);
    const r = rowOf(cell);
    const c = colOf(cell);
    const moves: Record<string, number> = {
      ArrowUp: r > 0 ? cell - SIZE : cell,
      ArrowDown: r < SIZE - 1 ? cell + SIZE : cell,
      ArrowLeft: c > 0 ? cell - 1 : cell,
      ArrowRight: c < SIZE - 1 ? cell + 1 : cell,
      Home: cell - c,
      End: cell - c + SIZE - 1,
    };

    if (e.key in moves) setFocus(moves[e.key], true);
    else if (e.key === " " || e.key === "Enter") setCell(cell, (board[cell] + 1) % 3);
    else if (e.key === "Delete" || e.key === "Backspace") setCell(cell, EMPTY);
    else return;
    e.preventDefault();
  });

  // ---------- Toolbar ----------
  window.addEventListener("puzzle:undo", () => {
    if (status !== "playing" || !undoStack.length) return;
    board = undoStack.pop()!;
    changed();
  });

  window.addEventListener("puzzle:reset", () => {
    if (status === "loading") return;
    // Starting over after solving also restarts the stopped timer
    if (status !== "playing") {
      seconds = 0;
      window.dispatchEvent(new Event("puzzle:timer-reset"));
    }
    setStatus("playing");
    board = new Array(SIZE * SIZE).fill(EMPTY);
    undoStack = [];
    changed();
  });

  // Fixes the first wrong mark (a buoy that doesn't belong, or water over a buoy), otherwise places a missing buoy
  window.addEventListener("puzzle:hint", () => {
    if (status !== "playing") return;
    let cell = board.findIndex((state, i) => state !== EMPTY && (state === BUOY) !== puzzle.solution[i]);
    if (cell === -1) cell = board.findIndex((state, i) => state === EMPTY && puzzle.solution[i]);
    if (cell === -1) return;
    setCell(cell, puzzle.solution[cell] ? BUOY : WATER);
    const el = cellEls[cell];
    el.classList.remove("is-hinted");
    void el.offsetWidth; // restart the pulse if it's still running
    el.classList.add("is-hinted");
    el.addEventListener("animationend", () => el.classList.remove("is-hinted"), { once: true });
  });

  // Every buoy in place and the rest marked as water, then the board locks (no celebration)
  window.addEventListener("puzzle:reveal", () => {
    if (status !== "playing") return;
    setStatus("revealed");
    board = puzzle.solution.map((buoy) => (buoy ? BUOY : WATER));
    undoStack = [];
    changed();
    window.dispatchEvent(new Event("puzzle:revealed"));
  });

  // ---------- Loading a day ----------
  /**
   * Gets the day's puzzle (showing "Shuffling…" if it still has to be made) and lays out the saved
   * board if there is one, otherwise an empty one. Then makes the other difficulties in the background.
   */
  async function load() {
    const id = ++loadId;
    if (!puzzles.has(difficulty, dateKey)) {
      setStatus("loading");
      await nextPaint();
      if (id !== loadId) return; // switched difficulty (or day) again in the meantime
    }

    puzzle = puzzles.get(difficulty, dateKey);
    drawPuzzle();
    undoStack = [];

    const saved = loadProgress<SavedGame>(slug, difficulty, dateKey);
    if (saved?.cells?.length === SIZE * SIZE) {
      board = saved.cells;
      seconds = saved.seconds;
      setStatus(saved.status);
      if (saved.status === "solved") fillWater(); // boards solved before empties were filled in
      window.dispatchEvent(
        new CustomEvent("puzzle:timer-set", { detail: { seconds, running: saved.status === "playing" } })
      );
    } else {
      board = new Array(SIZE * SIZE).fill(EMPTY);
      seconds = 0;
      setStatus("playing");
    }
    render();
    puzzles.prepare(dateKey);
  }

  window.addEventListener("puzzle:timer-tick", (e) => {
    seconds = (e as CustomEvent<{ seconds: number }>).detail.seconds;
    if (status === "playing") save();
  });

  // Save the finishing time the moment it's solved (the timer stops on this same event)
  window.addEventListener("puzzle:solved", save);

  window.addEventListener("puzzle:difficulty-change", (e) => {
    difficulty = (e as CustomEvent<{ value: BuoyDifficulty }>).detail.value;
    load();
  });

  window.addEventListener("puzzle:new-day", (e) => {
    dateKey = (e as CustomEvent<{ dateKey: string }>).detail.dateKey;
    forgetOldProgress(slug);
    load();
  });

  // Finished in another tab: show it finished here too, which also stops the timer
  onFinishedElsewhere(slug, (d, day) => {
    if (d === difficulty && day === dateKey && status === "playing") load();
  });

  forgetOldProgress(slug);
  load();
</script>
