---
// Picture examples for Buoy's "How to play": little boards drawn like the real one, each marked as
// allowed or not. A clue with too many buoys is coral, as on the real board.
import BuoyIcon from "./buoy.svg";

interface Example {
  ok: boolean;
  caption: string;
  cols: number;
  rows: number;
  /** Cells (reading order) holding a buoy */
  buoys: number[];
  /** Row clue drawn to the left of a one-row board */
  rowClue?: number;
  /** Each cell's region, for boards with region borders */
  regions?: number[];
  /** Region clues: the cell it's drawn in, and its number */
  regionClues?: { cell: number; count: number }[];
}

const examples: Example[] = [
  { ok: true, caption: "Row says 2: two buoys", cols: 5, rows: 1, rowClue: 2, buoys: [1, 3] },
  { ok: false, caption: "Row says 2: three buoys", cols: 5, rows: 1, rowClue: 2, buoys: [0, 2, 3] },
  {
    ok: true,
    caption: "Each region holds its number",
    cols: 3,
    rows: 3,
    regions: [0, 0, 1, 0, 1, 1, 0, 1, 1],
    regionClues: [{ cell: 0, count: 2 }, { cell: 2, count: 1 }],
    buoys: [1, 6, 5],
  },
  { ok: true, caption: "Buoys can touch", cols: 5, rows: 1, rowClue: 2, buoys: [2, 3] },
];

const CELL = 30;
const CLUE = 22; // width of the row clue column

/** Thick lines where two regions meet */
function regionLines({ cols, regions }: Example) {
  if (!regions) return [];
  const lines: { x1: number; y1: number; x2: number; y2: number }[] = [];
  regions.forEach((g, i) => {
    const r = Math.floor(i / cols);
    const c = i % cols;
    if (c > 0 && regions[i - 1] !== g) lines.push({ x1: c * CELL, y1: r * CELL, x2: c * CELL, y2: (r + 1) * CELL });
    if (r > 0 && regions[i - cols] !== g) lines.push({ x1: c * CELL, y1: r * CELL, x2: (c + 1) * CELL, y2: r * CELL });
  });
  return lines;
}
---

<div class="buoy-help mt-5">
  <p class="text-sm font-semibold text-ink">Examples</p>

  <ul class="mt-3 grid grid-cols-2 gap-2.5">
    {examples.map((example) => {
      const { ok, caption, cols, rows, buoys, rowClue, regionClues = [] } = example;
      const left = rowClue === undefined ? 0 : CLUE;
      const width = left + cols * CELL;
      const height = rows * CELL;
      return (
        <li class="flex flex-col items-center gap-2 rounded-xl p-3 ring-1 ring-line">
          <svg class:list={["w-auto max-w-full", rows > 1 ? "h-24" : "h-14"]} viewBox={`-3 -3 ${width + 6} ${height + 6}`} aria-hidden="true">
            {rowClue !== undefined && (
              <text class:list={["clue", !ok && "clue--over"]} x={CLUE / 2 - 2} y={height / 2}>{rowClue}</text>
            )}
            <g transform={`translate(${left} 0)`}>
              {Array.from({ length: cols * rows }, (_, i) => (
                <rect
                  class:list={["cell", buoys.includes(i) && "cell--buoy"]}
                  x={(i % cols) * CELL}
                  y={Math.floor(i / cols) * CELL}
                  width={CELL}
                  height={CELL}
                />
              ))}
              {regionLines(example).map((l) => <line class="region" {...l} />)}
              <rect class="frame" x="0" y="0" width={cols * CELL} height={height} rx="4" />
              {regionClues.map(({ cell, count }) => (
                <text class="region-clue" x={(cell % cols) * CELL + 4} y={Math.floor(cell / cols) * CELL + 8}>{count}</text>
              ))}
              {buoys.map((i) => (
                <BuoyIcon x={(i % cols) * CELL + 5} y={Math.floor(i / cols) * CELL + 5} width={CELL - 10} height={CELL - 10} />
              ))}
            </g>
          </svg>

          <p class="flex items-start gap-1.5 text-center text-xs leading-snug font-medium text-ink">
            {ok ? (
              <svg class="mt-px h-3.5 w-3.5 shrink-0 text-seafoam-strong" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Allowed">
                <path d="M20 6 9 17l-5-5"></path>
              </svg>
            ) : (
              <svg class="mt-px h-3.5 w-3.5 shrink-0 text-coral-strong" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" role="img" aria-label="Not allowed">
                <path d="M18 6 6 18M6 6l12 12"></path>
              </svg>
            )}
            {caption}
          </p>
        </li>
      );
    })}
  </ul>

  <p class="mt-4 text-xs leading-relaxed text-muted">
    Tip: start with the 0s. Every cell in that row, column or region is water, so mark it and see what's
    left.
  </p>
</div>

<style>
  .buoy-help {
    --region-border: color-mix(in srgb, rgb(var(--ink)) 45%, rgb(var(--surface)));
  }

  .cell {
    fill: rgb(var(--surface));
    stroke: rgb(var(--line) / 0.6);
    stroke-width: 1;
  }

  .cell--buoy {
    fill: color-mix(in srgb, rgb(var(--ocean)) 20%, rgb(var(--surface)));
  }

  .region,
  .frame {
    stroke: var(--region-border);
    stroke-width: 2.5;
    stroke-linecap: square;
  }

  .frame {
    fill: none;
  }

  .clue,
  .region-clue {
    fill: rgb(var(--ink));
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
  }

  .clue {
    font-size: 16px;
    text-anchor: middle;
    dominant-baseline: central;
  }

  .clue--over {
    fill: rgb(var(--coral-strong));
  }

  .region-clue {
    font-size: 8px;
    fill: rgb(var(--ink) / 0.7);
    dominant-baseline: central;
  }
</style>
