---
import PuzzleLayout from "../layouts/PuzzleLayout.astro";
import { PUZZLES } from "../puzzles";

// Only the slug goes through getStaticPaths. Its results are cached in dev, so passing the
// puzzle config as props would keep serving old components/config after you edit them.
export function getStaticPaths() {
  return Object.values(PUZZLES)
    .filter((puzzle) => !puzzle.comingSoon || import.meta.env.DEV)
    .map(({ slug }) => ({ params: { id: slug } }));
}

const puzzle = PUZZLES[Astro.params.id!];
const ActivePuzzleComponent = puzzle.component;
---

<PuzzleLayout puzzle={puzzle}>
  {
    ActivePuzzleComponent ? (
      <ActivePuzzleComponent puzzle={puzzle} />
    ) : (
      <p class="text-center font-semibold text-muted">
        Component not found for "{puzzle.name}"
      </p>
    )
  }
</PuzzleLayout>
