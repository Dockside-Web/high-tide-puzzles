---
import Layout from "../layouts/Layout.astro";

const pageTitle = "Page Not Found";
const metaDescription = "This page doesn't exist.";
---

<Layout title={pageTitle} description={metaDescription} noindex>
  <section class="mx-auto flex w-full max-w-3xl flex-col items-center px-6 pt-16 text-center sm:pt-24">
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Page not found</h1>
    <p class="mt-3 text-sm text-muted">This page drifted out with the tide.</p>
    <a
      href="/"
      class="mt-6 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-on-color transition-transform hover:scale-[1.02] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:ring-offset-2"
    >
      Back to today's puzzles
    </a>
  </section>
</Layout>
