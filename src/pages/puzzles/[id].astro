---
import PuzzleLayout from "../../layouts/PuzzleLayout.astro";
import { PUZZLES, type PuzzleConfig } from "../../data/puzzles";

export function getStaticPaths() {
  return Object.keys(PUZZLES).map((id) => ({
    params: { id },
    props: { puzzle: PUZZLES[id] },
  }));
}

interface Props {
  puzzle: PuzzleConfig;
}

const { puzzle } = Astro.props;

// Vite's import.meta.glob lazily imports components and types modules automatically
const modules = import.meta.glob<{ default: any }>("../../components/puzzles/*.astro", {
  eager: true,
});

// Map components by filename (e.g., "TestPuzzle")
const componentMap = Object.fromEntries(
  Object.entries(modules).map(([path, module]) => {
    const filename = path.split("/").pop()?.replace(".astro", "") || "";
    return [filename, module.default];
  })
);

const ActivePuzzleComponent = componentMap[puzzle.component];
---

<PuzzleLayout
  name={puzzle.name}
  icon={puzzle.icon}
  instructions={puzzle.instructions}
>
  {
    ActivePuzzleComponent ? (
      <ActivePuzzleComponent puzzle={puzzle} />
    ) : (
      <p class="text-center font-semibold text-muted">
        Component "{puzzle.component}.astro" not found in src/components/puzzles/
      </p>
    )
  }
</PuzzleLayout>