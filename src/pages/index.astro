---
import Layout from "../layouts/Layout.astro";
import DailyPuzzles from "../components/home/DailyPuzzles.astro";
import FAQ from "../components/home/FAQ.astro";
import Contact from "../components/home/Contact.astro";

const metaDescription="Free daily puzzles — a new challenge every day.";
---

<Layout description={metaDescription} footer>
  <DailyPuzzles />
  <FAQ />
  <Contact />

  <script>
    function scrollToHash() {
      if (location.hash) {
        const target = document.querySelector(location.hash)
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' })
          return
        }
      }
      window.scrollTo({ top: 0 })
    }
    window.addEventListener('DOMContentLoaded', scrollToHash)
    window.addEventListener('hashchange', scrollToHash)
  </script>
</Layout>
