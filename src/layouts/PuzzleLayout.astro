---
import Layout from "./Layout.astro";
import PuzzleHeader from "../components/puzzle/PuzzleHeader.astro";
import PuzzleControls from "../components/puzzle/PuzzleControls.astro";
import PauseOverlay from "../components/puzzle/PauseOverlay.astro";
import Toolbar from "../components/puzzle/Toolbar.astro";
import HelpModal from "../components/puzzle/HelpModal.astro";
import SolvedCelebration from "../components/puzzle/SolvedCelebration.astro";
import { puzzleColorStyle, type PuzzleConfig } from "../puzzles/types";

// Shared wrapper for every puzzle page. The puzzle itself goes in the slot;
// everything around it is switched on/off by the puzzle's config.

interface Props {
  puzzle: PuzzleConfig;
}

const { puzzle } = Astro.props;
const {
  name,
  icon,
  color,
  instructions,
  helpExamples: HelpExamples,
  difficulties = [],
  timer = true,
  toolbar,
} = puzzle;

const hasControls = difficulties.length > 0 || timer;

// What search results show for this page: the puzzle's tagline, then what's on offer
const description = `${puzzle.tagline} A new ${name} puzzle every day, free to play with no sign-up.`;
---

<Layout title={`${name} Daily Puzzle`} description={description} compact>
  <div class="flex w-full flex-col px-3 pt-5 pb-4 sm:px-6 sm:pt-7" style={puzzleColorStyle(color)}>
    <div class="mx-auto w-full max-w-3xl">
      <PuzzleHeader name={name} icon={icon} />

      {hasControls && (
        <div class="mt-3">
          <PuzzleControls difficulties={difficulties} showTimer={timer} />
        </div>
      )}
    </div>

    <!-- Board (allowed to be wider than the header for wide puzzles) -->
    <div class="relative mx-auto mt-6 flex w-full max-w-6xl flex-col items-center sm:mt-9" data-puzzle-board>
      <slot />
      {timer && <PauseOverlay />}
    </div>

    {toolbar && (
      <div class="mt-6 sm:mt-8">
        <Toolbar config={toolbar} />
      </div>
    )}

    <HelpModal slug={puzzle.slug} name={name} icon={icon} instructions={instructions}>
      {HelpExamples && <HelpExamples />}
    </HelpModal>
    <!-- Every puzzle finishes the same way: fire "puzzle:solved" and this takes it from there -->
    <SolvedCelebration name={name} icon={icon} />
  </div>
</Layout>
